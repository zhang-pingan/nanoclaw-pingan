{
  "name": "icarus",
  "version": "1.2.14",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "packageManager": "npm@11.17.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/clean-typescript-output.mjs && tsc",
    "start": "./local/shell/start.sh --mode current",
    "dev": "tsx src/index.ts",
    "dev:electron": "node scripts/build-electron.mjs && electron dist-electron/main.cjs",
    "dev:electron:watch": "node scripts/build-electron.mjs && electron dist-electron/main.cjs",
    "build:electron": "node scripts/build-electron.mjs",
    "dev:assistant": "node scripts/build-assistant.mjs && electron dist-assistant/main.cjs",
    "build:assistant": "node scripts/build-assistant.mjs",
    "package:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "contracts:check": "npm run golden:check && npm run golden:replay && npm run contracts:g3:check && npm run contracts:g3.registry:check && npm run contracts:g3.query:check && npm run contracts:g3.6:check && npm run contracts:g3.7:check && npm run contracts:g3.8a:check && npm run contracts:g3.9:check && npm run contracts:g3.2a:check && npm run contracts:g3.2:check && npm run schema:check && npm run contracts:static:check",
    "contracts:check:full": "npm run contracts:check && npm run workflow-runtime:release:check",
    "contracts:execution-binding:generate": "tsx src/workflow-runtime/contracts/capability-outbox-binding-cli.ts generate",
    "contracts:execution-binding:check": "tsx src/workflow-runtime/contracts/capability-outbox-binding-cli.ts check",
    "schema:generate": "tsx src/workflow-runtime/store/schema/cli.ts generate",
    "schema:check": "tsx src/workflow-runtime/store/schema/cli.ts check",
    "contracts:r020:generate": "tsx src/workflow-runtime/contracts/r020-child-consumption-lineage-contract-cli.ts generate",
    "contracts:r020:check": "tsx src/workflow-runtime/contracts/r020-child-consumption-lineage-contract-cli.ts check",
    "contracts:r021:generate": "tsx src/workflow-runtime/contracts/r021-map-terminal-consumption-contract-cli.ts generate",
    "contracts:r021:check": "tsx src/workflow-runtime/contracts/r021-map-terminal-consumption-contract-cli.ts check",
    "contracts:r022:generate": "tsx src/workflow-runtime/contracts/r022-domain-claim-handoff-contract-cli.ts generate",
    "contracts:r022:check": "tsx src/workflow-runtime/contracts/r022-domain-claim-handoff-contract-cli.ts check",
    "store:check": "tsx src/workflow-runtime/store/runtime-store/check.ts",
    "typecheck": "tsc --noEmit",
    "contracts:static:check": "vitest run src/workflow-runtime/contracts/gateway-boundary.test.ts",
    "workflow-runtime:release:check": "node scripts/verify-dynamic-workflow-runtime-v1-release.mjs",
    "test:workflow-runtime:certification": "vitest run src/workflow-runtime/certification/release-manifest.test.ts src/workflow-runtime/certification/benchmark-model.test.ts src/workflow-runtime/certification/g8-readiness-artifacts.test.ts",
    "test:workflow-runtime:activation": "vitest run src/workflow-runtime/registry/production-activation.test.ts setup/runtime-toolchain.test.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "test": "npm run test:current",
    "test:current": "npm run test:g0 && npm run test:g1.1 && npm run test:g1.2 && npm run test:g2 && npm run golden:replay && npm run test:current:registry && npm run test:current:runtime && npm run test:host-core",
    "test:full": "npm run test:current && npm run test:workflow-runtime:certification && npm run test:workflow-runtime:activation && npm run workflow-runtime:release:check",
    "test:host-core": "vitest run src/host-core/*.test.ts setup/service.test.ts setup/toolchain-identity.test.ts",
    "test:current:registry": "vitest run src/workflow-runtime/store/registry-persistence.test.ts src/workflow-runtime/store/registry-resource-query.test.ts src/workflow-runtime/store/retention-executor-abi-preflight.test.ts src/workflow-runtime/authoring/workflow-publisher.test.ts src/workflow-runtime/authoring/feature-release-activation.test.ts",
    "test:current:runtime": "vitest run src/workflow-runtime/store/node-output-envelope-value-store.test.ts src/workflow-runtime/runtime/g5-basic-runtime.test.ts src/workflow-runtime/capacity/capacity-admin.test.ts src/workflow-runtime/contracts/g6-dynamic-close-reference-model.test.ts src/workflow-runtime/runtime/g6-dynamic-close.test.ts src/workflow-runtime/contracts/g7-control-projection-reference-model.test.ts src/workflow-runtime/runtime/g7-control-recovery.test.ts src/workflow-runtime/runtime/g7-card-presentation.test.ts src/workflow-runtime/projection/g7-workflow-projection.test.ts",
    "test:g0.7": "vitest run src/workflow-runtime/contracts/gateway-boundary.test.ts",
    "test:g1.1": "vitest run src/workflow-runtime/store/schema/schema.test.ts src/workflow-runtime/store/schema/schema-activation-repair.test.ts",
    "test:g1.publisher": "vitest run src/workflow-runtime/store/schema/schema.test.ts -t Publisher",
    "test:g1.activation": "vitest run src/workflow-runtime/store/schema/schema-activation-repair.test.ts src/workflow-runtime/store/schema/schema.test.ts -t 'G1.6|G1.5 enforces Release|G1.5 preserves held Retention'",
    "test:g1.2": "vitest run src/workflow-runtime/store/runtime-store/runtime-store.test.ts",
    "test:store:node-output-envelope": "vitest run src/workflow-runtime/store/node-output-envelope-value-store.test.ts",
    "test:g1.capacity": "vitest run src/workflow-runtime/contracts/capacity-control-plane.test.ts src/workflow-runtime/store/schema/schema.test.ts src/workflow-runtime/store/runtime-store/runtime-store.test.ts",
    "golden:update": "tsx src/workflow-runtime/compiler/golden-cli.ts update",
    "golden:check": "tsx src/workflow-runtime/compiler/golden-cli.ts check",
    "golden:replay": "tsx src/workflow-runtime/compiler/golden-cli.ts replay",
    "contracts:g3:generate": "tsx src/workflow-runtime/contracts/g3-registry-publish-foundation-cli.ts generate",
    "contracts:g3:check": "tsx src/workflow-runtime/contracts/g3-registry-publish-foundation-cli.ts check",
    "contracts:g3.registry:generate": "tsx src/workflow-runtime/contracts/g3-registry-persistence-cli.ts generate",
    "contracts:g3.registry:check": "tsx src/workflow-runtime/contracts/g3-registry-persistence-cli.ts check",
    "contracts:g3.query:generate": "tsx src/workflow-runtime/contracts/g3-registry-exact-resource-query-cli.ts generate",
    "contracts:g3.query:check": "tsx src/workflow-runtime/contracts/g3-registry-exact-resource-query-cli.ts check",
    "contracts:g3.6:generate": "tsx src/workflow-runtime/contracts/g3-retention-executor-abi-preflight-cli.ts generate",
    "contracts:g3.6:check": "tsx src/workflow-runtime/contracts/g3-retention-executor-abi-preflight-cli.ts check",
    "contracts:g3.7:generate": "tsx src/workflow-runtime/contracts/g3-workflow-publisher-cli.ts generate",
    "contracts:g3.7:check": "tsx src/workflow-runtime/contracts/g3-workflow-publisher-cli.ts check",
    "contracts:g3.8a:generate": "tsx src/workflow-runtime/contracts/g3-8a-activation-contract-repair-cli.ts generate",
    "contracts:g3.8a:check": "tsx src/workflow-runtime/contracts/g3-8a-activation-contract-repair-cli.ts check",
    "contracts:g3.2a:generate": "tsx src/workflow-runtime/contracts/g3-2a-feature-manifest-intake-cli.ts generate",
    "contracts:g3.2a:check": "tsx src/workflow-runtime/contracts/g3-2a-feature-manifest-intake-cli.ts check",
    "contracts:g3.2:generate": "tsx src/workflow-runtime/contracts/g3-2-feature-manifest-intake-cli.ts generate",
    "contracts:g3.2:check": "tsx src/workflow-runtime/contracts/g3-2-feature-manifest-intake-cli.ts check",
    "test:g2:golden-current": "vitest run src/workflow-runtime/compiler/golden.test.ts",
    "test:g2": "vitest run src/workflow-runtime/compiler/static-child-plan-bundle.test.ts src/workflow-runtime/compiler/generated-output-schema-authority.test.ts src/workflow-runtime/compiler/golden.test.ts",
    "test:g2:generated-output-schema": "vitest run src/workflow-runtime/compiler/generated-output-schema-authority.test.ts",
    "test:g3.7": "vitest run src/workflow-runtime/contracts/g3-workflow-publisher.test.ts src/workflow-runtime/authoring/workflow-publisher.test.ts",
    "test:g3.8a": "vitest run src/workflow-runtime/contracts/g3-8a-activation-contract-repair.test.ts",
    "contracts:g3.9:generate": "tsx src/workflow-runtime/contracts/g3-feature-release-activation-cli.ts generate",
    "contracts:g3.9:check": "tsx src/workflow-runtime/contracts/g3-feature-release-activation-cli.ts check",
    "test:g3.9": "vitest run src/workflow-runtime/contracts/g3-feature-release-activation.test.ts src/workflow-runtime/authoring/feature-release-activation.test.ts",
    "test:g3": "vitest run src/workflow-runtime/contracts/g3-registry-publish-foundation.test.ts src/workflow-runtime/contracts/g3-registry-persistence.test.ts src/workflow-runtime/store/registry-persistence.test.ts src/workflow-runtime/contracts/g3-registry-exact-resource-query.test.ts src/workflow-runtime/store/registry-resource-query.test.ts src/workflow-runtime/contracts/g3-retention-executor-abi-preflight.test.ts src/workflow-runtime/store/retention-executor-abi-preflight.test.ts src/workflow-runtime/contracts/g3-workflow-publisher.test.ts src/workflow-runtime/authoring/workflow-publisher.test.ts src/workflow-runtime/contracts/g3-8a-activation-contract-repair.test.ts src/workflow-runtime/contracts/g3-feature-release-activation.test.ts src/workflow-runtime/authoring/feature-release-activation.test.ts src/workflow-runtime/contracts/g3-2a-feature-manifest-intake.test.ts src/workflow-runtime/contracts/g3-2-feature-manifest-intake.test.ts",
    "contracts:g5:generate": "tsx src/workflow-runtime/contracts/g5-basic-runtime-repair-cli.ts generate",
    "contracts:g5:check": "tsx src/workflow-runtime/contracts/g5-basic-runtime-repair-cli.ts check",
    "contracts:g6:generate": "tsx src/workflow-runtime/contracts/g6-dynamic-close-contract-cli.ts generate",
    "contracts:g6:check": "tsx src/workflow-runtime/contracts/g6-dynamic-close-contract-cli.ts check",
    "contracts:g7:generate": "tsx src/workflow-runtime/contracts/g7-control-projection-contract-cli.ts generate",
    "contracts:g7:check": "tsx src/workflow-runtime/contracts/g7-control-projection-contract-cli.ts check",
    "test:g5": "vitest run src/workflow-runtime/contracts/g5-basic-runtime-repair-contract.test.ts src/workflow-runtime/contracts/g5-basic-runtime-repair-reference-model.test.ts src/workflow-runtime/store/node-output-envelope-value-store.test.ts src/workflow-runtime/runtime/g5-basic-runtime.test.ts src/workflow-runtime/capacity/capacity-admin.test.ts",
    "test:g5:blocker": "vitest run src/workflow-runtime/contracts/g5-capability-outbox-blocker.test.ts",
    "test:r020": "vitest run src/workflow-runtime/contracts/r020-child-consumption-lineage.test.ts",
    "test:r021": "vitest run src/workflow-runtime/contracts/r021-map-terminal-consumption.test.ts src/workflow-runtime/contracts/g6-map-terminal-consumption-blocker.test.ts",
    "test:r022": "vitest run src/workflow-runtime/contracts/r022-domain-claim-handoff.test.ts src/workflow-runtime/contracts/g6-required-child-claim-handoff-blocker.test.ts",
    "test:g6": "vitest run src/workflow-runtime/contracts/g6-dynamic-close-contract.test.ts src/workflow-runtime/contracts/g6-dynamic-close-reference-model.test.ts src/workflow-runtime/runtime/g6-dynamic-close.test.ts",
    "test:g7": "vitest run src/workflow-runtime/contracts/g7-control-projection-contract.test.ts src/workflow-runtime/contracts/g7-control-projection-reference-model.test.ts src/workflow-runtime/runtime/g7-control-recovery.test.ts src/workflow-runtime/runtime/g7-card-presentation.test.ts src/workflow-runtime/projection/g7-workflow-projection.test.ts",
    "test:g0": "npm run contracts:check && vitest run setup/toolchain-identity.test.ts setup/runtime-toolchain.test.ts setup/service.test.ts src/workflow-runtime/contracts/gateway-boundary.test.ts src/internal-agent-run-once/handler.test.ts src/internal-agent-run-once/service.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.5.0",
    "form-data": "^4.0.5",
    "json-canonicalize": "2.0.0",
    "jsonc-parser": "3.3.1",
    "mysql2": "^3.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "three": "^0.184.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv-cli": "^11.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "fast-check": "4.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
