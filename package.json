{
  "name": "icarus",
  "version": "1.2.14",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "packageManager": "npm@11.17.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/clean-typescript-output.mjs && tsc",
    "start": "./local/shell/start.sh --mode current",
    "dev": "tsx src/index.ts",
    "dev:electron": "node scripts/build-electron.mjs && electron dist-electron/main.cjs",
    "dev:electron:watch": "node scripts/build-electron.mjs && electron dist-electron/main.cjs",
    "build:electron": "node scripts/build-electron.mjs",
    "dev:assistant": "node scripts/build-assistant.mjs && electron dist-assistant/main.cjs",
    "build:assistant": "node scripts/build-assistant.mjs",
    "spike:collaboration:codex": "tsx scripts/collaboration-codex-app-server-spike.ts",
    "contracts:check": "npm run golden:check && npm run golden:replay && npm run contracts:g3:check && npm run contracts:g3.registry:check && npm run contracts:g3.query:check && npm run contracts:g3.7:check && npm run contracts:g3.9:check && npm run contracts:g3.2a:check && npm run contracts:g3.2:check && npm run schema:check && npm run contracts:static:check",
    "contracts:execution-binding:generate": "tsx src/workflow-runtime/contracts/capability-outbox-binding-cli.ts generate",
    "contracts:execution-binding:check": "tsx src/workflow-runtime/contracts/capability-outbox-binding-cli.ts check",
    "schema:check": "tsx src/workflow-runtime/store/runtime-store/check.ts",
    "store:check": "tsx src/workflow-runtime/store/runtime-store/check.ts",
    "typecheck": "tsc --noEmit",
    "contracts:static:check": "vitest run src/workflow-runtime/contracts/gateway-boundary.test.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "test": "npm run test:current",
    "test:current": "npm run test:g0 && npm run test:g1.1 && npm run test:g1.2 && npm run test:g2 && npm run golden:replay && npm run test:current:registry && npm run test:current:runtime && npm run test:host-core && npm run test:collaboration",
    "test:full": "npm run test:current",
    "test:host-core": "vitest run src/host-core/*.test.ts setup/service.test.ts setup/toolchain-compatibility.test.ts",
    "test:collaboration": "vitest run src/collaboration/*.test.ts src/collaboration/**/*.test.ts electron/codex-thread-link.test.ts electron/renderer/collaboration-definition.test.ts electron/renderer/collaboration-fsm.test.ts electron/renderer/collaboration-ui.test.ts",
    "test:current:registry": "vitest run src/workflow-runtime/store/registry-persistence.test.ts src/workflow-runtime/store/registry-resource-query.test.ts src/workflow-runtime/store/release-runtime-compatibility.test.ts src/workflow-runtime/authoring/workflow-publisher.test.ts src/workflow-runtime/authoring/feature-release-activation.test.ts",
    "test:current:runtime": "vitest run src/workflow-runtime/store/node-output-envelope-value-store.test.ts src/workflow-runtime/runtime/g5-basic-runtime.test.ts src/workflow-runtime/capacity/capacity-admin.test.ts src/workflow-runtime/contracts/g6-dynamic-close-reference-model.test.ts src/workflow-runtime/runtime/g6-dynamic-close.test.ts src/workflow-runtime/contracts/g7-control-projection-reference-model.test.ts src/workflow-runtime/runtime/g7-control-recovery.test.ts src/workflow-runtime/runtime/g7-card-presentation.test.ts src/workflow-runtime/projection/g7-workflow-projection.test.ts",
    "test:g0.7": "vitest run src/workflow-runtime/contracts/gateway-boundary.test.ts",
    "test:g1.1": "tsx src/workflow-runtime/store/runtime-store/check.ts",
    "test:g1.2": "vitest run src/workflow-runtime/store/runtime-store/runtime-store.test.ts",
    "test:store:node-output-envelope": "vitest run src/workflow-runtime/store/node-output-envelope-value-store.test.ts",
    "test:g1.capacity": "vitest run src/workflow-runtime/contracts/capacity-control-plane.test.ts src/workflow-runtime/store/runtime-store/runtime-store.test.ts",
    "golden:update": "tsx src/workflow-runtime/compiler/golden-cli.ts update",
    "golden:check": "tsx src/workflow-runtime/compiler/golden-cli.ts check",
    "golden:replay": "tsx src/workflow-runtime/compiler/golden-cli.ts replay",
    "contracts:g3:generate": "tsx src/workflow-runtime/contracts/g3-registry-publish-foundation-cli.ts generate",
    "contracts:g3:check": "tsx src/workflow-runtime/contracts/g3-registry-publish-foundation-cli.ts check",
    "contracts:g3.registry:generate": "tsx src/workflow-runtime/contracts/g3-registry-persistence-cli.ts generate",
    "contracts:g3.registry:check": "tsx src/workflow-runtime/contracts/g3-registry-persistence-cli.ts check",
    "contracts:g3.query:generate": "tsx src/workflow-runtime/contracts/g3-registry-exact-resource-query-cli.ts generate",
    "contracts:g3.query:check": "tsx src/workflow-runtime/contracts/g3-registry-exact-resource-query-cli.ts check",
    "contracts:g3.7:generate": "tsx src/workflow-runtime/contracts/g3-workflow-publisher-cli.ts generate",
    "contracts:g3.7:check": "tsx src/workflow-runtime/contracts/g3-workflow-publisher-cli.ts check",
    "contracts:g3.2a:generate": "tsx src/workflow-runtime/contracts/g3-2a-feature-manifest-intake-cli.ts generate",
    "contracts:g3.2a:check": "tsx src/workflow-runtime/contracts/g3-2a-feature-manifest-intake-cli.ts check",
    "contracts:g3.2:generate": "tsx src/workflow-runtime/contracts/g3-2-feature-manifest-intake-cli.ts generate",
    "contracts:g3.2:check": "tsx src/workflow-runtime/contracts/g3-2-feature-manifest-intake-cli.ts check",
    "test:g2:golden-current": "vitest run src/workflow-runtime/compiler/golden.test.ts",
    "test:g2": "vitest run src/workflow-runtime/compiler/static-child-plan-bundle.test.ts src/workflow-runtime/compiler/generated-output-schema-authority.test.ts src/workflow-runtime/compiler/golden.test.ts",
    "test:g2:generated-output-schema": "vitest run src/workflow-runtime/compiler/generated-output-schema-authority.test.ts",
    "test:g3.7": "vitest run src/workflow-runtime/contracts/g3-workflow-publisher.test.ts src/workflow-runtime/authoring/workflow-publisher.test.ts",
    "contracts:g3.9:generate": "tsx src/workflow-runtime/contracts/g3-feature-release-activation-cli.ts generate",
    "contracts:g3.9:check": "tsx src/workflow-runtime/contracts/g3-feature-release-activation-cli.ts check",
    "test:g3.9": "vitest run src/workflow-runtime/contracts/g3-feature-release-activation.test.ts src/workflow-runtime/authoring/feature-release-activation.test.ts",
    "test:g3": "vitest run src/workflow-runtime/contracts/g3-registry-publish-foundation.test.ts src/workflow-runtime/contracts/g3-registry-persistence.test.ts src/workflow-runtime/store/registry-persistence.test.ts src/workflow-runtime/contracts/g3-registry-exact-resource-query.test.ts src/workflow-runtime/store/registry-resource-query.test.ts src/workflow-runtime/store/release-runtime-compatibility.test.ts src/workflow-runtime/contracts/g3-workflow-publisher.test.ts src/workflow-runtime/authoring/workflow-publisher.test.ts src/workflow-runtime/contracts/g3-feature-release-activation.test.ts src/workflow-runtime/authoring/feature-release-activation.test.ts src/workflow-runtime/contracts/g3-2a-feature-manifest-intake.test.ts src/workflow-runtime/contracts/g3-2-feature-manifest-intake.test.ts",
    "test:g5": "vitest run src/workflow-runtime/contracts/g5-basic-runtime-fixture-harness.test.ts src/workflow-runtime/contracts/g5-basic-runtime-repair-reference-model.test.ts src/workflow-runtime/store/node-output-envelope-value-store.test.ts src/workflow-runtime/runtime/g5-basic-runtime.test.ts src/workflow-runtime/capacity/capacity-admin.test.ts",
    "test:g5:blocker": "vitest run src/workflow-runtime/contracts/g5-capability-outbox-blocker.test.ts",
    "test:g6": "vitest run src/workflow-runtime/contracts/g6-dynamic-close-reference-model.test.ts src/workflow-runtime/runtime/g6-dynamic-close.test.ts",
    "test:g7": "vitest run src/workflow-runtime/contracts/g7-control-projection-reference-model.test.ts src/workflow-runtime/runtime/g7-control-recovery.test.ts src/workflow-runtime/runtime/g7-card-presentation.test.ts src/workflow-runtime/projection/g7-workflow-projection.test.ts",
    "test:g0": "npm run contracts:check && vitest run setup/toolchain-compatibility.test.ts setup/runtime-toolchain.test.ts setup/service.test.ts src/workflow-runtime/contracts/gateway-boundary.test.ts src/internal-agent-run-once/handler.test.ts src/internal-agent-run-once/service.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.5.0",
    "form-data": "^4.0.5",
    "json-canonicalize": "2.0.0",
    "jsonc-parser": "3.3.1",
    "mysql2": "^3.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "three": "^0.184.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv-cli": "^11.0.0",
    "electron": "^33.4.11",
    "esbuild": "^0.24.0",
    "fast-check": "4.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
