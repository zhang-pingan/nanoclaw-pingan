{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "icarus.collaboration-repository-verification/1"
    },
    "level": {
      "type": "string",
      "enum": [
        "verified",
        "self_consistent",
        "projection_only",
        "unverified"
      ]
    },
    "repository_identity": {
      "type": "string",
      "enum": [
        "trusted_input_match",
        "not_externally_anchored",
        "not_established"
      ]
    },
    "requested_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "resolved_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "repository_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "genesis_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trusted_genesis": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trusted_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checks": {
      "type": "object",
      "properties": {
        "git_repository": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "ref_resolution": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "complete_history_validation": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "linear_commit_history": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "strict_protocol_json": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "event_schema_and_payload_hash": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "aggregate_revision_and_previous_hash": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "commit_order": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "commit_signatures_and_actor_credentials": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "reducer_replay": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "materialized_projection": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "projection_json_readable": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "business_file_hashes": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        }
      },
      "required": [
        "git_repository",
        "ref_resolution",
        "complete_history_validation",
        "linear_commit_history",
        "strict_protocol_json",
        "event_schema_and_payload_hash",
        "aggregate_revision_and_previous_hash",
        "commit_order",
        "commit_signatures_and_actor_credentials",
        "reducer_replay",
        "materialized_projection",
        "projection_json_readable",
        "business_file_hashes"
      ],
      "additionalProperties": false
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "level",
    "repository_identity",
    "requested_ref",
    "resolved_ref",
    "repository_head",
    "genesis_commit",
    "trusted_genesis",
    "trusted_head",
    "event_count",
    "checks",
    "failure"
  ],
  "additionalProperties": false
}
