{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:icarus:production-activation-request:1",
  "title": "Icarus Production Activation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "operation",
    "activation_id",
    "operation_key",
    "requested_at_ms",
    "audit",
    "deployment_binding"
  ],
  "properties": {
    "format": {
      "const": "icarus.production-activation-request/1"
    },
    "operation": {
      "const": "activate"
    },
    "activation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "requested_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:icarus:production-activation-audit:1",
      "title": "Icarus Production Activation Audit",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "activation_id",
        "actor_ref",
        "requested_at_ms",
        "request_hash",
        "target_release_artifact_hash",
        "previous_deployment_binding_hash",
        "capacity_mode",
        "authority_hash",
        "audit_hash"
      ],
      "properties": {
        "format": {
          "const": "icarus.production-activation-audit/1"
        },
        "activation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "actor_ref": {
          "const": "system:production-activation"
        },
        "requested_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_release_artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "previous_deployment_binding_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity_mode": {
          "enum": [
            "fresh_genesis",
            "existing_preserved"
          ]
        },
        "authority_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "audit_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "deployment_binding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:icarus:deployment-activation-binding:1",
      "title": "Icarus Deployment Activation Binding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "deployment_profile",
        "runtime_surface",
        "release_manifest_hash",
        "release_artifact_hash",
        "core_build_hash",
        "core_binding_hash",
        "capacity_genesis_bootstrap_bundle_hash",
        "applicable_g8_evidence",
        "static_authority",
        "feature_registry_pointer",
        "runtime_center_projection",
        "capacity_authority",
        "activation_audit_hash",
        "binding_hash"
      ],
      "properties": {
        "format": {
          "const": "icarus.deployment-activation-binding/1"
        },
        "deployment_profile": {
          "const": "local_single_user"
        },
        "runtime_surface": {
          "const": "node_service"
        },
        "release_manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "release_artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "core_build_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "core_binding_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capacity_genesis_bootstrap_bundle_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "applicable_g8_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "release_artifact_hash",
            "startup_report_hash",
            "readiness_report_hash",
            "startup_harness_hash",
            "readiness_harness_hash",
            "sqlite_profile_candidate_hash",
            "node_executable_hash",
            "native_module_hash"
          ],
          "properties": {
            "status": {
              "const": "fresh_independent_boundary_pass"
            },
            "release_artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "startup_report_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "readiness_report_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "startup_harness_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "readiness_harness_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sqlite_profile_candidate_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "node_executable_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "native_module_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "static_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_core_build_hash",
            "absence_baseline_hash",
            "product_surface_manifest_hash",
            "migration_candidate_boundary_hash"
          ],
          "properties": {
            "source_core_build_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "absence_baseline_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "product_surface_manifest_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "migration_candidate_boundary_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "feature_registry_pointer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "active_release_count",
            "pointers",
            "pointer_aggregate_hash"
          ],
          "properties": {
            "state": {
              "enum": [
                "empty",
                "present"
              ]
            },
            "active_release_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pointers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feature_id",
                  "release_id",
                  "release_hash"
                ],
                "properties": {
                  "feature_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "release_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "release_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            },
            "pointer_aggregate_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "runtime_center_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection_version",
            "generations",
            "generation_aggregate_hash"
          ],
          "properties": {
            "projection_version": {
              "const": "g7.1"
            },
            "generations": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "view",
                  "generation_id",
                  "source_head_seq",
                  "rows_hash"
                ],
                "properties": {
                  "view": {
                    "enum": [
                      "workflows",
                      "agent_executions",
                      "pending",
                      "trace"
                    ]
                  },
                  "generation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "source_head_seq": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rows_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            },
            "generation_aggregate_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "capacity_authority": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "expected_head_state",
                "baseline_config_hash",
                "expected_capacity_revision",
                "expected_change_id",
                "expected_publication_hash",
                "expected_audit_head_hash",
                "genesis_core_release_hash",
                "genesis_command_id",
                "genesis_idempotency_key",
                "genesis_auth_session_ref",
                "genesis_activation_audit_authority_hash",
                "genesis_evidence_value_id",
                "genesis_evidence_value_hash"
              ],
              "properties": {
                "mode": {
                  "const": "fresh_genesis"
                },
                "expected_head_state": {
                  "const": "absent"
                },
                "baseline_config_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "expected_capacity_revision": {
                  "const": 1
                },
                "expected_change_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "expected_publication_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "expected_audit_head_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "genesis_core_release_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "genesis_command_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "genesis_idempotency_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "genesis_auth_session_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "genesis_activation_audit_authority_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "genesis_evidence_value_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "genesis_evidence_value_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "capacity_revision",
                "change_id",
                "config_hash",
                "publication_hash",
                "publication_file_raw_hash",
                "audit_head_hash",
                "dependency_objects_hash"
              ],
              "properties": {
                "mode": {
                  "const": "existing_preserved"
                },
                "capacity_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "change_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "config_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "publication_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "publication_file_raw_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "audit_head_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "dependency_objects_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "activation_audit_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
