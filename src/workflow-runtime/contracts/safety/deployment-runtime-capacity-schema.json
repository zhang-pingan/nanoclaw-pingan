    "$id": "urn:icarus:deployment-runtime-capacity:1",
    "title": "Deployment Runtime Capacity v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "max_active_executions",
      "max_active_waits",
      "max_pending_signals",
      "max_outbox_inflight",
      "max_physical_blob_bytes",
