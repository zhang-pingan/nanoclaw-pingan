        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "max_physical_blob_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "soft_blob_high_water_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "minimum_free_disk_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
