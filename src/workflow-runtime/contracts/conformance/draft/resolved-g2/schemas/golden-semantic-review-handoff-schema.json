{
  "format": "icarus.workflow-compiler-golden-semantic-review-handoff-schema/1",
  "ref": {
    "id": "icarus.workflow-compiler-golden-semantic-review-handoff-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-compiler-golden-semantic-review-handoff-schema:1\n",
  "hash": "sha256:51133e46278d914313cb66395432fc57d6bb877b5ff4bf31602c6cf66e3e8549",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/golden-semantic-review-handoff-v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "handoff_version",
      "review_owner",
      "review_decision_status",
      "resolved_case_catalog_ref",
      "resolved_case_catalog_hash",
      "actual_candidate_manifest_ref",
      "actual_candidate_manifest_hash",
      "actual_candidate_disposition",
      "review_input_disposition",
      "expected_oracle_status",
      "case_handoffs",
      "review_checklist",
      "forbidden_actions",
      "golden_semantic_review_record_ref",
      "golden_semantic_review_record_hash",
      "approval_status",
      "golden_seal_status",
      "conformance_sealed_write_status",
      "handoff_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-golden-semantic-review-handoff/1"
      },
      "handoff_version": {
        "const": "1.0.0-resolved-draft"
      },
      "review_owner": {
        "const": "human:local-owner"
      },
      "review_decision_status": {
        "const": "pending_not_recorded"
      },
      "resolved_case_catalog_ref": {
        "const": "conformance/draft/resolved-g2/golden-draft-cases@3.json"
      },
      "resolved_case_catalog_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "actual_candidate_manifest_ref": {
        "const": "conformance/candidate/g2/candidate-results-manifest@1.json"
      },
      "actual_candidate_manifest_hash": {
        "const": "sha256:c471bcf03ea23ce2d84d5a785b026ae222ec47f7d5fd5948bb8e19c89904b1d2"
      },
      "actual_candidate_disposition": {
        "const": "comparison_input_only_not_expected_oracle"
      },
      "review_input_disposition": {
        "const": "hand_authored_assertions_and_diagnostics_pending_review"
      },
      "expected_oracle_status": {
        "const": "absent_pending_human_decision"
      },
      "case_handoffs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "review_input_pointer",
            "actual_candidate_result_ref",
            "actual_candidate_result_hash",
            "expected_oracle_pointer",
            "review_status"
          ],
          "properties": {
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "review_input_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "actual_candidate_result_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "actual_candidate_result_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "expected_oracle_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "review_status": {
              "const": "pending_human_semantic_review"
            }
          }
        },
        "minItems": 40,
        "maxItems": 40
      },
      "review_checklist": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 5
      },
      "forbidden_actions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 6,
        "uniqueItems": true
      },
      "golden_semantic_review_record_ref": {
        "type": "null"
      },
      "golden_semantic_review_record_hash": {
        "type": "null"
      },
      "approval_status": {
        "const": "not_run"
      },
      "golden_seal_status": {
        "const": "not_run"
      },
      "conformance_sealed_write_status": {
        "const": "not_run"
      },
      "handoff_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
