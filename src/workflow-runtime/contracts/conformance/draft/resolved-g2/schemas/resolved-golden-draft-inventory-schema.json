{
  "format": "icarus.workflow-compiler-resolved-golden-draft-inventory-schema/1",
  "ref": {
    "id": "icarus.workflow-compiler-resolved-golden-draft-inventory-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-compiler-resolved-golden-draft-inventory-schema:1\n",
  "hash": "sha256:4d62ce960d0482967d007bfe4dec0c74e4a054f2c798b6eb90fc5b5e8bc49b48",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/resolved-golden-draft-inventory-v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "inventory_version",
      "entries",
      "entry_count",
      "inventory_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-resolved-golden-draft-inventory/1"
      },
      "inventory_version": {
        "const": "1.0.0"
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "role",
            "format",
            "ref",
            "version",
            "domain_separator",
            "artifact_hash",
            "raw_bytes_hash",
            "byte_length"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "role": {
              "type": "string",
              "enum": [
                "schema",
                "case_catalog",
                "semantic_review_handoff",
                "positive_fixture",
                "negative_fixture"
              ]
            },
            "format": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
                }
              }
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "domain_separator": {
              "type": "string",
              "minLength": 1
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "raw_bytes_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "minItems": 1
      },
      "entry_count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "inventory_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
