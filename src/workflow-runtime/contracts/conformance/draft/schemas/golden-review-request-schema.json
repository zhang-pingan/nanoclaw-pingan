{
  "format": "icarus.workflow-golden-review-request-schema/1",
  "ref": {
    "id": "icarus.workflow-golden-review-request-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-golden-review-request-schema:1\n",
  "hash": "sha256:b3c616080fa8fc744af528e546caa592b2283e57fdc47280d873746161d9f2a1",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/icarus-workflow-golden-review-request/1",
    "title": "icarus.workflow-golden-review-request/1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "review_request_id",
      "draft_manifest_ref",
      "draft_manifest_hash",
      "requested_reviewer_actor_ref",
      "checklist_version",
      "case_ids",
      "previous_bundle_ref",
      "previous_bundle_hash",
      "semantic_decision_status",
      "approval_record_status",
      "immutable_request_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-golden-review-request/1"
      },
      "review_request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
      },
      "draft_manifest_ref": {
        "type": "string",
        "minLength": 1,
        "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
      },
      "draft_manifest_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "requested_reviewer_actor_ref": {
        "const": "human:local-owner"
      },
      "checklist_version": {
        "const": "golden-semantic-review-checklist@1"
      },
      "case_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "previous_bundle_ref": {
        "type": "null"
      },
      "previous_bundle_hash": {
        "type": "null"
      },
      "semantic_decision_status": {
        "const": "pending"
      },
      "approval_record_status": {
        "const": "absent"
      },
      "immutable_request_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "$defs": {
      "json_value": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/json_value"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/json_value"
            }
          }
        ]
      },
      "versioned_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
          }
        }
      }
    }
  }
}
