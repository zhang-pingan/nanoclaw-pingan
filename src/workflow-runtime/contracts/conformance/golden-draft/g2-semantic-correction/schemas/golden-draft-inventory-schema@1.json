{
  "format": "icarus.workflow-current-g2-golden-draft-inventory-schema/1",
  "ref": {
    "id": "icarus.workflow-current-g2-golden-draft-inventory-schema",
    "version": "1.0.0-draft"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-current-g2-golden-draft-inventory-schema:1\n",
  "hash": "sha256:163a3c0258e5c43c5195eacac070a38187c405ccc949be23bd7c40c176184bc8",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/current-g2-golden-draft-inventory-v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "construction_phase",
      "inventory_scope",
      "entry_count",
      "entries",
      "inventory_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-current-g2-golden-draft-inventory/1"
      },
      "construction_phase": {
        "const": "RC_REVIEW"
      },
      "inventory_scope": {
        "const": "all_draft_leaf_artifacts_excluding_manifest"
      },
      "entry_count": {
        "type": "integer",
        "minimum": 1
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "kind",
            "case_id",
            "raw_bytes_hash",
            "semantic_hash",
            "domain_separator"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "kind": {
              "enum": [
                "schema",
                "case_catalog",
                "expected_result",
                "expected_plan",
                "expected_proofs",
                "expected_programs"
              ]
            },
            "case_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "raw_bytes_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "domain_separator": {
              "type": "string",
              "pattern": "^icarus:[ -~]+\\n$"
            }
          }
        },
        "minItems": 1
      },
      "inventory_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
