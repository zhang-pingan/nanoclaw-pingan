{
  "format": "icarus.workflow-compiler-g2-case-input-binding-requirement-schema/1",
  "ref": {
    "id": "icarus.workflow-compiler-g2-case-input-binding-requirement-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-compiler-g2-case-input-binding-requirement-schema:1\n",
  "hash": "sha256:ba8110b2ed753d86599ee57c4c3bce7e7442d5e6a315ee1e47cd4fb54eac44fb",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/icarus-workflow-compiler-g2-case-input-binding-requirement/1",
    "title": "icarus.workflow-compiler-g2-case-input-binding-requirement/1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "historical_g0_8_manifest_ref",
      "historical_g0_8_manifest_hash",
      "historical_case_catalog_ref",
      "historical_case_catalog_hash",
      "historical_input_snapshot_semantics",
      "resolved_binding_format",
      "resolved_binding_schema_ref",
      "resolved_binding_schema_hash",
      "effective_case_input_domain_separator",
      "binding_domain_separator",
      "required_exact_identity_fields",
      "case_requirements",
      "resolution_status",
      "review_barrier",
      "mutation_policy",
      "requirement_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-g2-case-input-binding-requirement/1"
      },
      "historical_g0_8_manifest_ref": {
        "type": "string",
        "pattern": "^contract-pack-golden-draft.json$"
      },
      "historical_g0_8_manifest_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "historical_case_catalog_ref": {
        "type": "string",
        "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
      },
      "historical_case_catalog_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "historical_input_snapshot_semantics": {
        "const": "frozen_g0_stage_absence_not_g2_identity"
      },
      "resolved_binding_format": {
        "const": "icarus.workflow-compiler-g2-case-input-binding/1"
      },
      "resolved_binding_schema_ref": {
        "type": "string",
        "pattern": "^conformance/compiler-contract-repair/[A-Za-z0-9.@_/-]+$"
      },
      "resolved_binding_schema_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "effective_case_input_domain_separator": {
        "const": "icarus:workflow-compiler-effective-case-input:1\n"
      },
      "binding_domain_separator": {
        "const": "icarus:workflow-compiler-g2-case-input-binding:1\n"
      },
      "required_exact_identity_fields": {
        "const": [
          "compiler_toolchain_manifest_ref",
          "compiler_toolchain_hash",
          "compiler_version",
          "compiler_build_hash",
          "canonical_normalizer_version",
          "canonical_normalizer_hash",
          "proof_algorithm_version",
          "proof_algorithm_hash",
          "error_catalog_ref",
          "error_catalog_hash",
          "compiled_ir_schema_ref",
          "compiled_ir_schema_hash",
          "conformance_result_schema_ref",
          "conformance_result_schema_hash"
        ]
      },
      "case_requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "raw_source_bytes_ref",
            "raw_source_bytes_hash",
            "historical_input_snapshot_ref",
            "historical_input_snapshot_hash",
            "resolved_binding_ref",
            "resolved_binding_hash",
            "effective_case_input_hash",
            "status"
          ],
          "properties": {
            "case_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
            },
            "raw_source_bytes_ref": {
              "type": "string",
              "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
            },
            "raw_source_bytes_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "historical_input_snapshot_ref": {
              "type": "string",
              "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
            },
            "historical_input_snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "resolved_binding_ref": {
              "type": "null"
            },
            "resolved_binding_hash": {
              "type": "null"
            },
            "effective_case_input_hash": {
              "type": "null"
            },
            "status": {
              "const": "pending_exact_g2_identity"
            }
          }
        },
        "minItems": 40,
        "maxItems": 40,
        "uniqueItems": true
      },
      "resolution_status": {
        "const": "pending_g2_compiler_implementation"
      },
      "review_barrier": {
        "const": "blocked_until_resolved_binding_is_published"
      },
      "mutation_policy": {
        "const": "publish_new_version_never_rewrite"
      },
      "requirement_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "$defs": {
      "json_value": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/json_value"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/json_value"
            }
          }
        ]
      },
      "versioned_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
          }
        }
      }
    }
  }
}
