        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
          }
        }
      },
      "compiler_toolchain_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "compiler_version": {
        "type": "string",
        "minLength": 1
      },
      "compiler_build_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "canonical_normalizer_version": {
        "type": "string",
        "minLength": 1
      },
      "canonical_normalizer_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "proof_algorithm_version": {
        "type": "string",
        "minLength": 1
      },
      "proof_algorithm_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
