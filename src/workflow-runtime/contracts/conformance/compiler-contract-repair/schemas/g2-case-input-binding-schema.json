              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "effective_case_input_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "minItems": 40,
        "maxItems": 40,
        "uniqueItems": true
      },
      "binding_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
