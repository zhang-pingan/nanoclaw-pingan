{
  "format": "icarus.workflow-compiler-golden-draft-cases-schema/2",
  "ref": {
    "id": "icarus.workflow-compiler-golden-draft-cases-schema",
    "version": "2.0.0"
  },
  "version": 2,
  "domain_separator": "icarus:workflow-compiler-golden-draft-cases-schema:2\n",
  "hash": "sha256:7cecaf90ac8126ba16e5a836a9bc09d23eb1a04b8d7e15de41551dfcb6afdb95",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/icarus-workflow-compiler-golden-draft-cases/2",
    "title": "icarus.workflow-compiler-golden-draft-cases/2",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "bundle_version",
      "historical_case_catalog_ref",
      "historical_case_catalog_hash",
      "assertion_target",
      "cases",
      "positive_case_count",
      "negative_case_count",
      "catalog_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-golden-draft-cases/2"
      },
      "bundle_version": {
        "const": "2.0.0-contract-repair"
      },
      "historical_case_catalog_ref": {
        "type": "string",
        "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
      },
      "historical_case_catalog_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "assertion_target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_format",
          "schema_ref",
          "schema_hash",
          "pointer_root",
          "canonicalization",
          "encoding",
          "canonical_bytes",
          "hash_field",
          "hash_preimage",
          "hash_domain_separator"
        ],
        "properties": {
          "artifact_format": {
            "const": "icarus.workflow-compiler-conformance-case-result/1"
          },
          "schema_ref": {
            "type": "string",
            "pattern": "^conformance/compiler-contract-repair/[A-Za-z0-9.@_/-]+$"
          },
          "schema_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "pointer_root": {
            "const": ""
          },
          "canonicalization": {
            "const": "rfc8785_jcs"
          },
          "encoding": {
            "const": "utf-8"
          },
          "canonical_bytes": {
            "const": "jcs_full_result_including_result_hash"
          },
          "hash_field": {
            "const": "result_hash"
          },
          "hash_preimage": {
            "const": "jcs_result_without_result_hash"
          },
          "hash_domain_separator": {
            "const": "icarus:workflow-compiler-conformance-case-result:1\n"
          }
        }
      },
      "cases": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "polarity",
            "source_kind",
            "coverage_tags",
            "raw_source_bytes_ref",
            "raw_source_bytes_hash",
            "historical_input_snapshot_ref",
            "historical_input_snapshot_hash",
            "expected_source_hash",
            "g2_case_input_binding_ref",
            "g2_case_input_binding_hash",
            "expected_case_result_bytes_ref",
            "expected_case_result_hash",
            "expected_plan_hash",
            "expected_proof_hashes",
            "expected_program_hashes",
            "expected_diagnostics",
            "semantic_assertions",
            "review_status",
            "authored_by"
          ],
          "properties": {
            "case_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
            },
            "polarity": {
              "type": "string",
              "enum": [
                "positive",
                "negative"
              ]
            },
            "source_kind": {
              "type": "string",
              "enum": [
                "graph_scope",
                "workflow_definition",
                "workflow_schema"
              ]
            },
            "coverage_tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "raw_source_bytes_ref": {
              "type": "string",
              "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
            },
            "raw_source_bytes_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "historical_input_snapshot_ref": {
              "type": "string",
              "pattern": "^conformance/draft/[A-Za-z0-9.@_/-]+$"
            },
            "historical_input_snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "expected_source_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "g2_case_input_binding_ref": {
              "type": "null"
            },
            "g2_case_input_binding_hash": {
              "type": "null"
            },
            "expected_case_result_bytes_ref": {
              "type": "null"
            },
            "expected_case_result_hash": {
              "type": "null"
            },
            "expected_plan_hash": {
              "type": "null"
            },
            "expected_proof_hashes": {
              "type": "null"
            },
            "expected_program_hashes": {
              "type": "null"
            },
            "expected_diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "phase",
                  "instance_pointer",
                  "schema_pointer",
                  "stable_object_id",
                  "detail_ref"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "json_syntax_invalid",
                      "json_duplicate_key",
                      "schema_unknown_field",
                      "schema_profile_keyword_unsupported",
                      "registry_ref_unpinned",
                      "registry_ref_not_found",
                      "graph_id_duplicate",
                      "graph_endpoint_not_found",
                      "graph_cross_scope_edge",
                      "graph_dependency_cycle",
                      "condition_type_mismatch",
                      "condition_complexity_exceeded",
                      "json_pointer_non_total",
                      "schema_not_assignable",
                      "route_group_ambiguous",
                      "trigger_contract_invalid",
                      "completion_contract_invalid",
                      "early_completion_non_monotone",
                      "early_completion_cancellation_unsafe",
                      "capability_not_allowed",
                      "policy_escalation",
                      "quality_revision_contract_invalid",
                      "quality_revision_effect_key_incompatible",
                      "child_recipe_set_mismatch",
                      "child_recipe_dependency_cycle",
                      "runtime_safety_limit_exceeded",
                      "compiler_integrity_mismatch"
                    ]
                  },
                  "phase": {
                    "type": "string",
                    "enum": [
                      "parse",
                      "schema",
                      "bind",
                      "prove",
                      "normalize",
                      "hash"
                    ]
                  },
                  "instance_pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                  },
                  "schema_pointer": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^#(?:/(?:[^~/]|~[01])*)*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stable_object_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "semantic_assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assertion_id",
                  "subject_pointer",
                  "operator",
                  "expected",
                  "rationale"
                ],
                "properties": {
                  "assertion_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
                  },
                  "subject_pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                  },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "equals",
                      "set_equals",
                      "ordered_equals",
                      "contains",
                      "present",
                      "absent"
                    ]
                  },
                  "expected": {
                    "$ref": "#/$defs/json_value"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minItems": 1
            },
            "review_status": {
              "const": "blocked_pending_exact_g2_identity"
            },
            "authored_by": {
              "const": "codex:contract-repair-author"
            }
          }
        },
        "minItems": 40,
        "maxItems": 40
      },
      "positive_case_count": {
        "const": 10
      },
      "negative_case_count": {
        "const": 30
      },
      "catalog_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "$defs": {
      "json_value": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/json_value"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/json_value"
            }
          }
        ]
      },
      "versioned_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
          }
        }
      }
    }
  }
}
