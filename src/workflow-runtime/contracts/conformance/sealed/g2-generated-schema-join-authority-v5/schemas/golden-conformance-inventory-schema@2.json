{
  "format": "icarus.workflow-compiler-conformance-inventory-schema/1",
  "ref": {
    "id": "icarus.workflow-compiler-conformance-inventory-schema.g2-generated-schema-join-authority-v5",
    "version": "2.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-compiler-conformance-inventory-schema:1\n",
  "hash": "sha256:e7fbee73c2a17596606b87a18eab59a64a9745ae22bc567c78e945bde11f0151",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/g2-replay-repair-successor-conformance-inventory-v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "gate",
      "bundle_version",
      "inventory_scope",
      "entry_count",
      "entries",
      "inventory_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-conformance-inventory/1"
      },
      "gate": {
        "const": "G2"
      },
      "bundle_version": {
        "const": "2.0.0"
      },
      "inventory_scope": {
        "const": "all_sealed_leaf_artifacts_excluding_inventory_and_bundle"
      },
      "entry_count": {
        "type": "integer",
        "minimum": 1
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "kind",
            "case_id",
            "original_ref",
            "raw_bytes_hash",
            "semantic_hash",
            "domain_separator"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "kind": {
              "enum": [
                "schema",
                "raw_source",
                "input_snapshot",
                "expected_result",
                "expected_plan",
                "expected_proofs",
                "expected_programs"
              ]
            },
            "case_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "original_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "raw_bytes_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "domain_separator": {
              "type": "string",
              "pattern": "^icarus:[ -~]+\\n$"
            }
          }
        },
        "minItems": 1
      },
      "inventory_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
