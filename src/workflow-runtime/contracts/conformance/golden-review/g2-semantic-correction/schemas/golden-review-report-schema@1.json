{
  "format": "icarus.workflow-current-g2-golden-review-report-schema/1",
  "ref": {
    "id": "icarus.workflow-current-g2-golden-review-report-schema",
    "version": "1.0.0-draft-review"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-current-g2-golden-review-report-schema:1\n",
  "hash": "sha256:d88cad966d4b96ec982502817fa3c8100f61d9c621b853c41498be0fdc03e3d2",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/current-g2-golden-review-report-v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "construction_phase",
      "report_kind",
      "publishable",
      "production_reachable",
      "draft_manifest_ref",
      "draft_manifest_hash",
      "review_candidate_ref",
      "review_candidate_hash",
      "candidate_root_ref",
      "candidate_root_hash",
      "actual_results_manifest_ref",
      "actual_results_manifest_hash",
      "actual_comparison_role",
      "case_count",
      "compiled_count",
      "rejected_count",
      "expected_coverage",
      "comparison_coverage",
      "byte_equal_count",
      "semantic_equal_count",
      "semantic_assertion_count",
      "semantic_assertion_failure_count",
      "difference_count",
      "cases",
      "human_review",
      "approval_status",
      "signature_status",
      "seal_status",
      "golden_semantic_review_status",
      "g3_through_g9_status",
      "report_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-compiler-current-g2-golden-review-report/1"
      },
      "construction_phase": {
        "const": "RC_REVIEW"
      },
      "report_kind": {
        "const": "read_only_draft_candidate_comparison"
      },
      "publishable": {
        "const": false
      },
      "production_reachable": {
        "const": false
      },
      "draft_manifest_ref": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
      },
      "draft_manifest_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "review_candidate_ref": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
      },
      "review_candidate_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "candidate_root_ref": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
      },
      "candidate_root_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "actual_results_manifest_ref": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
      },
      "actual_results_manifest_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "actual_comparison_role": {
        "const": "actual_compiler_output_not_golden_oracle"
      },
      "case_count": {
        "const": 40
      },
      "compiled_count": {
        "const": 11
      },
      "rejected_count": {
        "const": 29
      },
      "expected_coverage": {
        "const": 40
      },
      "comparison_coverage": {
        "const": 40
      },
      "byte_equal_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "semantic_equal_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "semantic_assertion_count": {
        "type": "integer",
        "minimum": 0
      },
      "semantic_assertion_failure_count": {
        "type": "integer",
        "minimum": 0
      },
      "difference_count": {
        "type": "integer",
        "minimum": 0
      },
      "cases": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "source_ref",
            "snapshot_ref",
            "expected_result_ref",
            "expected_result_hash",
            "actual_result_ref",
            "actual_result_hash",
            "outcome",
            "byte_equal",
            "semantic_equal",
            "normalized_plan",
            "diagnostic_pointers",
            "semantic_assertion_count",
            "semantic_assertion_failures",
            "difference_count",
            "differences"
          ],
          "properties": {
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "source_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "snapshot_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "expected_result_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "expected_result_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "actual_result_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_/-]*$"
            },
            "actual_result_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "outcome": {
              "enum": [
                "compiled",
                "rejected"
              ]
            },
            "byte_equal": {
              "type": "boolean"
            },
            "semantic_equal": {
              "type": "boolean"
            },
            "normalized_plan": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "diagnostic_pointers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
              }
            },
            "semantic_assertion_count": {
              "type": "integer",
              "minimum": 0
            },
            "semantic_assertion_failures": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "difference_count": {
              "type": "integer",
              "minimum": 0
            },
            "differences": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointer",
                  "kind",
                  "expected",
                  "actual"
                ],
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                  },
                  "kind": {
                    "enum": [
                      "missing_expected",
                      "missing_actual",
                      "value_mismatch"
                    ]
                  },
                  "expected": {
                    "$ref": "#/$defs/json_value"
                  },
                  "actual": {
                    "$ref": "#/$defs/json_value"
                  }
                }
              }
            }
          }
        },
        "minItems": 40,
        "maxItems": 40
      },
      "human_review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reviewer_actor_ref",
          "judgment_coverage"
        ],
        "properties": {
          "status": {
            "const": "not_requested"
          },
          "reviewer_actor_ref": {
            "const": "human:local-owner"
          },
          "judgment_coverage": {
            "const": 0
          }
        }
      },
      "approval_status": {
        "const": "absent"
      },
      "signature_status": {
        "const": "absent"
      },
      "seal_status": {
        "const": "absent"
      },
      "golden_semantic_review_status": {
        "const": "not_run"
      },
      "g3_through_g9_status": {
        "const": "not_started"
      },
      "report_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "$defs": {
      "json_value": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/json_value"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/json_value"
            }
          }
        ]
      }
    }
  }
}
