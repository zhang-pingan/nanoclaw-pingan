{
  "format": "icarus.workflow-g0-artifact-hash-inventory-schema/1",
  "ref": {
    "id": "icarus.workflow-g0-artifact-hash-inventory-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-g0-artifact-hash-inventory-schema:1\n",
  "hash": "sha256:c8a5ec915f39e39a2962fa1f362cef67e1e8dba019d2179d296ee9f0a52d1687",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:icarus:workflow-g0-artifact-hash-inventory:1",
    "title": "Workflow G0 artifact hash inventory v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "inventory_scope",
      "g0_9_closure_policy",
      "entries",
      "entry_count",
      "class_counts",
      "slice_counts",
      "duplicate_paths",
      "missing_paths",
      "inventory_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-g0-artifact-hash-inventory/1"
      },
      "inventory_scope": {
        "const": "all_g0_1_g0_8_exit_artifacts_and_raw_sources"
      },
      "g0_9_closure_policy": {
        "const": "g0_9_leaf_artifacts_owned_by_root_manifest"
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "owning_slice",
            "artifact_class",
            "path",
            "format",
            "byte_length",
            "raw_sha256",
            "semantic_hash_kind",
            "semantic_hash"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "owning_slice": {
              "enum": [
                "G0.1",
                "G0.2",
                "G0.3",
                "G0.4",
                "G0.5",
                "G0.6",
                "G0.7",
                "G0.8"
              ]
            },
            "artifact_class": {
              "enum": [
                "toolchain_identity",
                "contract_manifest",
                "contract_artifact",
                "raw_source_bytes",
                "capacity_config"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._@/-]+$"
            },
            "format": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "semantic_hash_kind": {
              "enum": [
                "artifact_envelope",
                "manifest_identity",
                "managed_distribution_manifest",
                "locked_toolchain_inputs",
                "raw_source_domain",
                "capacity_config",
                "file_sha256"
              ]
            },
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "minItems": 1
      },
      "entry_count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "class_counts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolchain_identity",
          "contract_manifest",
          "contract_artifact",
          "raw_source_bytes",
          "capacity_config"
        ],
        "properties": {
          "toolchain_identity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contract_manifest": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contract_artifact": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "raw_source_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "capacity_config": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "slice_counts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "G0.1",
          "G0.2",
          "G0.3",
          "G0.4",
          "G0.5",
          "G0.6",
          "G0.7",
          "G0.8"
        ],
        "properties": {
          "G0.1": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.2": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.3": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.4": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.5": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.6": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.7": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "G0.8": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "duplicate_paths": {
        "const": []
      },
      "missing_paths": {
        "const": []
      },
      "inventory_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
