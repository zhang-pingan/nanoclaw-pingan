            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "migration_candidate_boundary_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "production_source_hits": {
            "const": 0
          },
          "removed_api_hits": {
            "const": 0
          },
          "removed_ui_hits": {
            "const": 0
          },
          "legacy_schema_hits": {
            "const": 0
          },
          "legacy_filesystem_hits": {
            "const": 0
          },
          "active_resource_hits": {
            "const": 0
          },
          "candidate_reachability_hits": {
            "const": 0
