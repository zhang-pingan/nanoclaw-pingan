            "identity_kind",
            "primary_identity_hash",
            "supporting_identity_hashes"
          ],
          "properties": {
            "slice_id": {
              "enum": [
                "G0.1",
                "G0.2",
                "G0.3",
                "G0.4",
                "G0.5",
                "G0.6",
                "G0.7",
                "G0.8"
              ]
            },
            "identity_kind": {
              "enum": [
                "toolchain_manifest",
                "contract_pack_manifest"
              ]
            },
            "primary_identity_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "supporting_identity_hashes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "minItems": 0
            }
          }
        },
        "minItems": 8
      },
      "exit_criteria": {
        "type": "array",
