            "evidence_hashes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "minItems": 1
            }
          }
        },
        "minItems": 9
      },
      "markdown_coverage_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "artifact_inventory_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "absence_proof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_runtime_absence_hash",
          "product_surface_coverage_hash",
          "migration_candidate_boundary_hash",
          "production_source_hits",
          "removed_api_hits",
          "removed_ui_hits",
          "legacy_schema_hits",
          "legacy_filesystem_hits",
          "active_resource_hits",
