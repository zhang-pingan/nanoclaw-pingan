              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
            },
            "execution_status": {
              "const": "intent_only"
            }
          }
        },
        "minItems": 1
      },
      "invariants": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "delta_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
