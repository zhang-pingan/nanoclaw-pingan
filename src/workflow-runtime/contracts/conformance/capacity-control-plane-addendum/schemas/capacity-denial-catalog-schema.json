{
  "format": "icarus.workflow-capacity-denial-catalog-schema/1",
  "ref": {
    "id": "icarus.workflow-capacity-denial-catalog-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-capacity-denial-catalog-schema:1\n",
  "hash": "sha256:e1954c9088d2339b1e5baa3a56f9d34c0f6500926c1ff084b553e13624249379",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:icarus:workflow-capacity-denial-catalog:1",
    "title": "Capacity Denial Catalog v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "denial_codes",
      "entries",
      "catalog_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-capacity-denial-catalog/1"
      },
      "denial_codes": {
        "const": [
          "permission_denied",
          "actor_kind_denied",
          "capacity_already_initialized",
          "capacity_snapshot_invalid",
          "capacity_transition_invalid",
          "expected_capacity_revision_conflict",
          "expected_config_hash_conflict",
          "capacity_change_in_progress",
          "idempotency_conflict",
          "audit_unavailable",
          "publication_failed"
        ]
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "denial_code",
            "retryability",
            "head_mutation",
            "pending_change_creation",
            "invocation_audit"
          ],
          "properties": {
            "denial_code": {
              "enum": [
                "permission_denied",
                "actor_kind_denied",
                "capacity_already_initialized",
                "capacity_snapshot_invalid",
                "capacity_transition_invalid",
                "expected_capacity_revision_conflict",
                "expected_config_hash_conflict",
                "capacity_change_in_progress",
                "idempotency_conflict",
                "audit_unavailable",
                "publication_failed"
              ]
            },
            "retryability": {
              "enum": [
                "never_same_request",
                "refresh_head_and_resubmit",
                "retry_same_request"
              ]
            },
            "head_mutation": {
              "const": "forbidden"
            },
            "pending_change_creation": {
              "const": "forbidden"
            },
            "invocation_audit": {
              "const": "required_after_authentication"
            }
          }
        },
        "minItems": 11
      },
      "catalog_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
