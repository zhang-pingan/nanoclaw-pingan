  },
  "version": 1,
  "domain_separator": "icarus:workflow-capacity-control-plane-artifact-inventory-schema:1\n",
  "hash": "sha256:0c06f475e4973d604bc0ca5cec636907dc8973984fbf984598f1ceaca3b11cf4",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:icarus:workflow-capacity-control-plane-artifact-inventory:1",
    "title": "Capacity Control-Plane Artifact Inventory v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "inventory_scope",
      "closure_policy",
      "entries",
      "entry_count",
      "class_counts",
      "duplicate_paths",
      "missing_paths",
      "inventory_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-capacity-control-plane-artifact-inventory/1"
      },
      "inventory_scope": {
        "const": "g0_9_historical_root_and_g0_10_non_recursive_leaf_artifacts"
      },
      "closure_policy": {
        "const": "inventory_gate_domain_and_root_owned_by_g0_10_manifest"
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "owning_slice",
            "artifact_class",
            "path",
            "format",
            "byte_length",
            "raw_sha256",
            "semantic_hash"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "owning_slice": {
              "enum": [
                "G0.9",
                "G0.10"
              ]
            },
            "artifact_class": {
              "enum": [
                "historical_root",
                "schema",
                "catalog",
                "protocol",
                "logical_schema_delta",
                "coverage",
                "fixture"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._@/-]+$"
            },
            "format": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "minItems": 1
      },
      "entry_count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "class_counts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "historical_root",
          "schema",
          "catalog",
          "protocol",
          "logical_schema_delta",
          "coverage",
          "fixture"
        ],
        "properties": {
          "historical_root": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "catalog": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "protocol": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "logical_schema_delta": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "coverage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fixture": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "duplicate_paths": {
        "const": []
      },
      "missing_paths": {
        "const": []
      },
      "inventory_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
