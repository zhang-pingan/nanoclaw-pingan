  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:icarus:workflow-capacity-permission-catalog:1",
    "title": "Capacity Permission Catalog v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "permission_codes",
      "entries",
      "catalog_hash"
    ],
    "properties": {
