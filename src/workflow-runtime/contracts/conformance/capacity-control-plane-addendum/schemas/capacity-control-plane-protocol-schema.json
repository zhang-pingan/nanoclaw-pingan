{
  "format": "icarus.workflow-capacity-control-plane-protocol-schema/1",
  "ref": {
    "id": "icarus.workflow-capacity-control-plane-protocol-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-capacity-control-plane-protocol-schema:1\n",
  "hash": "sha256:e46c989e761232f7589a6723c2c39000e7b40b3566cdbf3e83384c5568abd79b",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:icarus:workflow-capacity-control-plane-protocol:1",
    "title": "Capacity Control-Plane CAP0-CAP4 Protocol v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "protocol_ids",
      "steps",
      "crash_boundaries",
      "protocol_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-capacity-control-plane-protocol/1"
      },
      "protocol_ids": {
        "const": [
          "CAP0",
          "CAP1",
          "CAP2",
          "CAP3",
          "CAP4"
        ]
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_id",
            "name",
            "transaction_mode",
            "external_work",
            "preconditions",
            "atomic_writes",
            "success_outcome",
            "failure_outcomes",
            "crash_recovery",
            "forbidden_actions"
          ],
          "properties": {
            "protocol_id": {
              "enum": [
                "CAP0",
                "CAP1",
                "CAP2",
                "CAP3",
                "CAP4"
              ]
            },
            "name": {
              "enum": [
                "authenticate_validate",
                "prepare",
                "install_file",
                "commit_head",
                "watcher_publish"
              ]
            },
            "transaction_mode": {
              "enum": [
                "none",
                "begin_immediate",
                "short_begin_immediate"
              ]
            },
            "external_work": {
              "enum": [
                "none",
                "filesystem_durability",
                "immutable_pointer_swap"
              ]
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "atomic_writes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "success_outcome": {
              "type": "string",
              "minLength": 1
            },
            "failure_outcomes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "crash_recovery": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "forbidden_actions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        "minItems": 5
      },
      "crash_boundaries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary_id",
            "protocol_id",
            "injected_after",
            "committed_head_visibility",
            "watcher_visibility",
            "recovery_action"
          ],
          "properties": {
            "boundary_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
            },
            "protocol_id": {
              "enum": [
                "CAP0",
                "CAP1",
                "CAP2",
                "CAP3",
                "CAP4"
              ]
            },
            "injected_after": {
              "type": "string",
              "minLength": 1
            },
            "committed_head_visibility": {
              "enum": [
                "old",
                "new"
              ]
            },
            "watcher_visibility": {
              "enum": [
                "old",
                "new"
              ]
            },
            "recovery_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "minItems": 4
      },
      "protocol_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
