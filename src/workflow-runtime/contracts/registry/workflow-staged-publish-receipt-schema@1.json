{
  "format": "icarus.workflow-staged-publish-receipt-schema/1",
  "ref": {
    "id": "icarus.workflow-staged-publish-receipt-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-staged-publish-receipt-schema:1\n",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/workflow-staged-publish-receipt/1",
    "title": "WorkflowStagedPublishReceiptV1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "command_id",
      "outcome",
      "domain_request_hash",
      "feature_release_ref",
      "feature_release_hash",
      "closure_ref",
      "closure_hash",
      "execution_artifact_ref",
      "execution_artifact_hash",
      "release_resources",
      "registry_publication_count",
      "retention_handle_id",
      "failure_code",
      "active_pointer_changed",
      "receipt_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-staged-publish-receipt/1"
      },
      "command_id": {
        "type": "string",
        "minLength": 1
      },
      "outcome": {
        "enum": [
          "applied",
          "failed"
        ]
      },
      "domain_request_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "feature_release_ref": {
        "$ref": "#/$defs/ref"
      },
      "feature_release_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "closure_ref": {
        "$ref": "#/$defs/ref"
      },
      "closure_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "execution_artifact_ref": {
        "$ref": "#/$defs/ref"
      },
      "execution_artifact_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "release_resources": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4097,
        "items": {
          "$ref": "#/$defs/release_resource"
        }
      },
      "registry_publication_count": {
        "type": "integer",
        "minimum": 0
      },
      "retention_handle_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "failure_code": {
        "anyOf": [
          {
            "enum": [
              "approved_review_invalid",
              "approved_review_expired",
              "approved_review_identity_mismatch",
              "caller_review_session_mismatch",
              "publish_request_invalid",
              "publish_request_hash_mismatch",
              "publish_identity_mismatch",
              "publish_foundation_preflight_failed",
              "registry_resource_preflight_failed",
              "retention_executor_abi_preflight_failed",
              "feature_release_identity_collision",
              "registry_publication_collision",
              "retention_root_identity_collision",
              "idempotency_conflict",
              "publisher_transaction_failed"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "active_pointer_changed": {
        "const": false
      },
      "receipt_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "$defs": {
      "ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
          }
        }
      },
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "ref",
          "content_hash"
        ],
        "properties": {
          "resource_type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "release_resource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "role"
        ],
        "properties": {
          "resource": {
            "$ref": "#/$defs/identity"
          },
          "role": {
            "enum": [
              "closure_root",
              "closure_member"
            ]
          }
        }
      }
    }
  },
  "hash": "sha256:421ce1a6c740a188183e48502d6ef714f6dafb5c0b5c29ec486d51d897f46d55"
}
