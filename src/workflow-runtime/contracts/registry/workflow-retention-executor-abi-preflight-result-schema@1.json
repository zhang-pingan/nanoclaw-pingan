{
  "format": "icarus.workflow-retention-executor-abi-preflight-result-schema/1",
  "ref": {
    "id": "icarus.workflow-retention-executor-abi-preflight-result-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-retention-executor-abi-preflight-result-schema:1\n",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/workflow-retention-executor-abi-preflight-result/1",
    "title": "WorkflowRetentionExecutorAbiPreflightResultV1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "outcome",
      "code",
      "bindings",
      "read_only"
    ],
    "properties": {
      "format": {
        "const": "icarus.workflow-retention-executor-abi-preflight-result/1"
      },
      "outcome": {
        "enum": [
          "accepted",
          "rejected"
        ]
      },
      "code": {
        "enum": [
          "preflight_ok",
          "preflight_input_invalid",
          "preflight_side_effect_requested",
          "snapshot_missing",
          "snapshot_hash_mismatch",
          "snapshot_binding_mismatch",
          "closure_root_missing",
          "closure_root_hash_mismatch",
          "closure_mismatch",
          "execution_artifact_missing",
          "execution_artifact_hash_mismatch",
          "execution_artifact_mismatch",
          "executor_implementation_missing",
          "executor_implementation_hash_mismatch",
          "executor_implementation_mismatch",
          "artifact_binding_mismatch",
          "core_compatibility_mismatch",
          "run_protocol_mismatch",
          "executor_abi_mismatch",
          "retention_policy_mismatch",
          "retention_eligibility_mismatch"
        ]
      },
      "bindings": {
        "anyOf": [
          {
            "$ref": "#/$defs/verified_bindings"
          },
          {
            "type": "null"
          }
        ]
      },
      "read_only": {
        "const": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "outcome": {
              "const": "accepted"
            }
          }
        },
        "then": {
          "properties": {
            "code": {
              "const": "preflight_ok"
            },
            "bindings": {
              "$ref": "#/$defs/verified_bindings"
            }
          }
        },
        "else": {
          "properties": {
            "code": {
              "enum": [
                "preflight_input_invalid",
                "preflight_side_effect_requested",
                "snapshot_missing",
                "snapshot_hash_mismatch",
                "snapshot_binding_mismatch",
                "closure_root_missing",
                "closure_root_hash_mismatch",
                "closure_mismatch",
                "execution_artifact_missing",
                "execution_artifact_hash_mismatch",
                "execution_artifact_mismatch",
                "executor_implementation_missing",
                "executor_implementation_hash_mismatch",
                "executor_implementation_mismatch",
                "artifact_binding_mismatch",
                "core_compatibility_mismatch",
                "run_protocol_mismatch",
                "executor_abi_mismatch",
                "retention_policy_mismatch",
                "retention_eligibility_mismatch"
              ]
            },
            "bindings": {
              "type": "null"
            }
          }
        }
      }
    ],
    "$defs": {
      "versioned_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
          }
        }
      },
      "verified_bindings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_release_ref",
          "feature_release_hash",
          "snapshot_ref",
          "snapshot_hash",
          "closure_ref",
          "closure_hash",
          "closure_member_count",
          "execution_artifact_count",
          "executor_implementation_count",
          "core_compatibility_ref",
          "core_compatibility_hash",
          "core_release_ref",
          "core_release_hash",
          "core_build_hash",
          "database_schema_version",
          "database_schema_hash",
          "run_protocol_ref",
          "run_protocol_hash",
          "run_protocol_major",
          "executor_abi_ref",
          "executor_abi_hash",
          "executor_abi_major",
          "retention_policy_ref",
          "retention_policy_hash",
          "retention_root_eligible"
        ],
        "properties": {
          "feature_release_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "feature_release_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "snapshot_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "snapshot_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "closure_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "closure_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "closure_member_count": {
            "type": "integer",
            "minimum": 0
          },
          "execution_artifact_count": {
            "type": "integer",
            "minimum": 0
          },
          "executor_implementation_count": {
            "type": "integer",
            "minimum": 0
          },
          "core_compatibility_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "core_compatibility_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "core_release_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "core_release_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "core_build_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "database_schema_version": {
            "const": 2
          },
          "database_schema_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "run_protocol_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "run_protocol_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "run_protocol_major": {
            "const": 1
          },
          "executor_abi_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "executor_abi_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "executor_abi_major": {
            "const": 1
          },
          "retention_policy_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "retention_policy_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "retention_root_eligible": {
            "const": true
          }
        }
      }
    }
  },
  "hash": "sha256:aa885fea3e2f7eb6d4112515c9f20699af6f634bb2da755080b8f31e9469d73e"
