              "artifact_contract",
              "capability",
              "card_presentation",
              "clarification_contract",
              "command_policy",
              "context_contract",
              "definition",
              "evaluator",
              "execution_policy",
              "executor_implementation",
              "feature_execution_artifact",
              "graph_policy",
              "graph_template",
              "notification_contract",
              "operational_remediation_policy",
              "outbox_adapter",
              "outbox_policy",
              "prompt",
              "recipe",
              "root_finalization_policy",
              "routing_capability",
              "routing_scope",
              "schema",
              "scope_interface",
              "tool_binding",
              "wait_contract"
