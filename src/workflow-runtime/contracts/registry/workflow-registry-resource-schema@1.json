            "properties": {
              "kind": {
                "const": "feature"
              },
              "feature_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "principal_ref"
            ],
            "properties": {
              "kind": {
                "const": "principal"
              },
              "principal_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
              }
            }
          }
        ]
      },
      "schema_ref": {
        "$ref": "#/$defs/versioned_ref"
      },
      "schema_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "content": {
        "type": "object"
      },
      "content_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "dependencies": {
        "type": "array",
        "maxItems": 4096,
        "items": {
          "$ref": "#/$defs/dependency"
        }
      }
    },
    "$defs": {
      "versioned_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
