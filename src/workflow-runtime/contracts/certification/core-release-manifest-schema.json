{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:icarus:core-release-manifest:1",
  "title": "Icarus Core Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "ref",
    "release_scope",
    "build_kind",
    "platform",
    "arch",
    "run_protocol_majors",
    "executor_abi_majors",
    "database_schema_version",
    "database_schema_hash",
    "managed_node_distribution_ref",
    "managed_node_distribution_hash",
    "runtime_launcher_hash",
    "runtime_toolchain_hash",
    "core_entry_relative_path",
    "core_entry_sha256",
    "validation_entry_relative_path",
    "validation_entry_sha256",
    "core_build_hash",
    "inventory",
    "inventory_hash",
    "release_artifact_hash"
  ],
  "properties": {
    "format": { "const": "icarus.core-release-manifest/1" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "icarus.core" },
        "version": { "const": "1.2.14" }
      }
    },
    "release_scope": { "const": "workflow_runtime_g8_validation" },
    "build_kind": { "const": "release" },
    "platform": { "const": "darwin" },
    "arch": { "const": "arm64" },
    "run_protocol_majors": {
      "type": "array",
      "prefixItems": [{ "const": 1 }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "executor_abi_majors": {
      "type": "array",
      "prefixItems": [{ "const": 1 }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "database_schema_version": { "const": 11 },
    "database_schema_hash": { "$ref": "#/$defs/hash" },
    "managed_node_distribution_ref": { "$ref": "#/$defs/versioned_ref" },
    "managed_node_distribution_hash": { "$ref": "#/$defs/hash" },
    "runtime_launcher_hash": { "$ref": "#/$defs/hash" },
    "runtime_toolchain_hash": { "$ref": "#/$defs/hash" },
    "core_entry_relative_path": { "const": "dist/index.js" },
    "core_entry_sha256": { "$ref": "#/$defs/hash" },
    "validation_entry_relative_path": {
      "const": "dist/workflow-runtime/certification/release-entry.js"
    },
    "validation_entry_sha256": { "$ref": "#/$defs/hash" },
    "core_build_hash": { "$ref": "#/$defs/hash" },
    "inventory": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_length", "executable", "raw_sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "executable": { "type": "boolean" },
          "raw_sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "inventory_hash": { "$ref": "#/$defs/hash" },
    "release_artifact_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
