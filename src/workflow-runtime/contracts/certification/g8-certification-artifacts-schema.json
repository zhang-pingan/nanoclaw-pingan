{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/workflow-runtime/g8-certification-artifacts/1",
  "title": "Dynamic Workflow Runtime G8 Certification Artifacts",
  "oneOf": [
    { "$ref": "#/$defs/sqlite_profile" },
    { "$ref": "#/$defs/benchmark_observation" },
    { "$ref": "#/$defs/runtime_supported_limits" },
    { "$ref": "#/$defs/certification_pack" }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "non_negative_number": {
      "type": "number",
      "minimum": 0
    },
    "sqlite_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "deployment_profile",
        "runtime_surface",
        "platform",
        "arch",
        "journal_mode",
        "synchronous",
        "foreign_keys",
        "busy_timeout_ms",
        "page_size",
        "auto_vacuum",
        "temp_store",
        "wal_autocheckpoint_pages",
        "journal_size_limit_bytes",
        "cache_size_kib",
        "mmap_size_bytes",
        "trusted_schema",
        "recursive_triggers",
        "read_uncommitted",
        "locking_mode",
        "read_only_query_only",
        "sqlite_version",
        "sqlite_source_id",
        "sqlite_compile_options_hash",
        "better_sqlite3_version",
        "better_sqlite3_native_module_hash",
        "managed_node_distribution_ref",
        "managed_node_distribution_hash",
        "node_runtime_version",
        "node_executable_hash",
        "release_artifact_hash",
        "runtime_launcher_hash",
        "profile_hash"
      ],
      "properties": {
        "ref": {
          "allOf": [
            { "$ref": "#/$defs/ref" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "icarus.local-single-user-sqlite" },
                "version": { "const": "1.0.0" }
              }
            }
          ]
        },
        "deployment_profile": { "const": "local_single_user" },
        "runtime_surface": { "const": "node_service" },
        "platform": { "const": "darwin" },
        "arch": { "const": "arm64" },
        "journal_mode": { "const": "wal" },
        "synchronous": { "const": "full" },
        "foreign_keys": { "const": true },
        "busy_timeout_ms": { "const": 5000 },
        "page_size": { "const": 4096 },
        "auto_vacuum": { "const": "incremental" },
        "temp_store": { "const": "memory" },
        "wal_autocheckpoint_pages": { "const": 4096 },
        "journal_size_limit_bytes": { "const": 67108864 },
        "cache_size_kib": { "const": 32768 },
        "mmap_size_bytes": { "const": 0 },
        "trusted_schema": { "const": false },
        "recursive_triggers": { "const": false },
        "read_uncommitted": { "const": false },
        "locking_mode": { "const": "normal" },
        "read_only_query_only": { "const": true },
        "sqlite_version": { "type": "string", "minLength": 1 },
        "sqlite_source_id": { "type": "string", "minLength": 1 },
        "sqlite_compile_options_hash": { "$ref": "#/$defs/hash" },
        "better_sqlite3_version": { "const": "12.11.1" },
        "better_sqlite3_native_module_hash": { "$ref": "#/$defs/hash" },
        "managed_node_distribution_ref": { "$ref": "#/$defs/ref" },
        "managed_node_distribution_hash": { "$ref": "#/$defs/hash" },
        "node_runtime_version": { "const": "26.5.0" },
        "node_executable_hash": { "$ref": "#/$defs/hash" },
        "release_artifact_hash": { "$ref": "#/$defs/hash" },
        "runtime_launcher_hash": { "$ref": "#/$defs/hash" },
        "profile_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "max_ms",
        "wal_bytes",
        "peak_rss_bytes",
        "affected_rows"
      ],
      "properties": {
        "p50_ms": { "$ref": "#/$defs/non_negative_number" },
        "p95_ms": { "$ref": "#/$defs/non_negative_number" },
        "p99_ms": { "$ref": "#/$defs/non_negative_number" },
        "max_ms": { "$ref": "#/$defs/non_negative_number" },
        "wal_bytes": { "type": "integer", "minimum": 0 },
        "peak_rss_bytes": { "$ref": "#/$defs/positive_integer" },
        "affected_rows": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "beyond_limit_rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_code",
        "attempted_dimensions",
        "database_before_hash",
        "database_after_hash",
        "affected_rows"
      ],
      "properties": {
        "status": { "const": "rejected_before_atomic_write" },
        "error_code": { "const": "runtime_supported_limit_exceeded" },
        "attempted_dimensions": { "$ref": "#/$defs/dimensions" },
        "database_before_hash": { "$ref": "#/$defs/hash" },
        "database_after_hash": { "$ref": "#/$defs/hash" },
        "affected_rows": { "const": 0 }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "benchmark_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "transaction",
        "shape",
        "profile",
        "scale_percent",
        "warmup_iterations",
        "measurement_iterations",
        "dimensions",
        "production_entry",
        "production_index_evidence",
        "correctness_invariants",
        "statistics",
        "beyond_limit_rejection"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^g8:(t3|t7|t8):[a-z0-9_]+:[a-z0-9_]+$" },
        "transaction": { "enum": ["t3", "t7", "t8"] },
        "shape": { "type": "string", "minLength": 1 },
        "profile": {
          "enum": [
            "smoke",
            "scaling_25",
            "scaling_50",
            "scaling_100",
            "supported_limit",
            "beyond_limit"
          ]
        },
        "scale_percent": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "warmup_iterations": { "const": 10 },
        "measurement_iterations": { "const": 100 },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "production_entry": {
          "enum": ["reconcileFactT3a", "requestScopeCloseT7a", "commitRootT8"]
        },
        "production_index_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "correctness_invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "statistics": {
          "oneOf": [{ "$ref": "#/$defs/statistics" }, { "type": "null" }]
        },
        "beyond_limit_rejection": {
          "oneOf": [
            { "$ref": "#/$defs/beyond_limit_rejection" },
            { "type": "null" }
          ]
        }
      }
    },
    "machine_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "purpose",
        "minimum_machine_class_ref",
        "minimum_machine_class_hash",
        "cpu_brand",
        "cpu_generation",
        "memory_bytes",
        "filesystem_type",
        "filesystem_device",
        "storage_class",
        "power_source",
        "benchmark_interference",
        "reference_machine",
        "observation_hash"
      ],
      "properties": {
        "format": { "const": "icarus.minimum-machine-observation/1" },
        "purpose": { "const": "certification_reference" },
        "minimum_machine_class_ref": { "$ref": "#/$defs/ref" },
        "minimum_machine_class_hash": { "$ref": "#/$defs/hash" },
        "cpu_brand": { "type": "string", "minLength": 1 },
        "cpu_generation": { "type": "integer", "minimum": 2 },
        "memory_bytes": { "type": "integer", "minimum": 17179869184 },
        "filesystem_type": { "const": "apfs" },
        "filesystem_device": { "type": "string", "minLength": 1 },
        "storage_class": { "const": "internal_ssd" },
        "power_source": { "const": "ac_power" },
        "benchmark_interference": { "const": "none_operator_confirmed" },
        "reference_machine": { "type": "string", "minLength": 1 },
        "observation_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "benchmark_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "ref",
        "benchmark_harness_ref",
        "benchmark_harness_hash",
        "benchmark_harness_version",
        "build_kind",
        "database_kind",
        "sqlite_profile_ref",
        "sqlite_profile_hash",
        "release_manifest_hash",
        "release_artifact_hash",
        "core_build_hash",
        "database_schema_hash",
        "runtime_launcher_hash",
        "runtime_toolchain_hash",
        "managed_node_distribution_hash",
        "machine_observation",
        "warmup_iterations",
        "measurement_iterations",
        "cases",
        "cases_hash",
        "observation_hash"
      ],
      "properties": {
        "format": { "const": "icarus.workflow-runtime-benchmark-observation/1" },
        "ref": { "$ref": "#/$defs/ref" },
        "benchmark_harness_ref": { "$ref": "#/$defs/ref" },
        "benchmark_harness_hash": { "$ref": "#/$defs/hash" },
        "benchmark_harness_version": { "const": "1.0.0" },
        "build_kind": { "const": "release" },
        "database_kind": { "const": "isolated_temporary_real_file" },
        "sqlite_profile_ref": { "$ref": "#/$defs/ref" },
        "sqlite_profile_hash": { "$ref": "#/$defs/hash" },
        "release_manifest_hash": { "$ref": "#/$defs/hash" },
        "release_artifact_hash": { "$ref": "#/$defs/hash" },
        "core_build_hash": { "$ref": "#/$defs/hash" },
        "database_schema_hash": { "$ref": "#/$defs/hash" },
        "runtime_launcher_hash": { "$ref": "#/$defs/hash" },
        "runtime_toolchain_hash": { "$ref": "#/$defs/hash" },
        "managed_node_distribution_hash": { "$ref": "#/$defs/hash" },
        "machine_observation": { "$ref": "#/$defs/machine_observation" },
        "warmup_iterations": { "const": 10 },
        "measurement_iterations": { "const": 100 },
        "cases": {
          "type": "array",
          "minItems": 90,
          "maxItems": 90,
          "items": { "$ref": "#/$defs/benchmark_case" }
        },
        "cases_hash": { "$ref": "#/$defs/hash" },
        "observation_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "limit_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "deployment_profile",
        "runtime_surface",
        "platform",
        "arch",
        "release_artifact_hash",
        "database_schema_hash",
        "core_build_hash",
        "runtime_launcher_hash",
        "managed_node_distribution_ref",
        "managed_node_distribution_hash",
        "sqlite_execution_profile_ref",
        "sqlite_execution_profile_hash",
        "benchmark_harness_version",
        "benchmark_harness_hash",
        "limit_derivation_hash",
        "reference_machine",
        "minimum_machine_class_ref",
        "minimum_machine_class_hash",
        "startup_smoke_harness_hash",
        "startup_smoke_max_duration_ms",
        "filesystem_type",
        "storage_class",
        "t3_max_transaction_duration_ms",
        "t7_max_transaction_duration_ms",
        "t8_max_transaction_duration_ms",
        "certified_at_ms"
      ],
      "properties": {
        "status": { "const": "certified" },
        "deployment_profile": { "const": "local_single_user" },
        "runtime_surface": { "const": "node_service" },
        "platform": { "const": "darwin" },
        "arch": { "const": "arm64" },
        "release_artifact_hash": { "$ref": "#/$defs/hash" },
        "database_schema_hash": { "$ref": "#/$defs/hash" },
        "core_build_hash": { "$ref": "#/$defs/hash" },
        "runtime_launcher_hash": { "$ref": "#/$defs/hash" },
        "managed_node_distribution_ref": { "$ref": "#/$defs/ref" },
        "managed_node_distribution_hash": { "$ref": "#/$defs/hash" },
        "sqlite_execution_profile_ref": { "$ref": "#/$defs/ref" },
        "sqlite_execution_profile_hash": { "$ref": "#/$defs/hash" },
        "benchmark_harness_version": { "const": "1.0.0" },
        "benchmark_harness_hash": { "$ref": "#/$defs/hash" },
        "limit_derivation_hash": { "$ref": "#/$defs/hash" },
        "reference_machine": { "type": "string", "minLength": 1 },
        "minimum_machine_class_ref": { "$ref": "#/$defs/ref" },
        "minimum_machine_class_hash": { "$ref": "#/$defs/hash" },
        "startup_smoke_harness_hash": { "$ref": "#/$defs/hash" },
        "startup_smoke_max_duration_ms": { "const": 5000 },
        "filesystem_type": { "const": "apfs" },
        "storage_class": { "const": "internal_ssd" },
        "t3_max_transaction_duration_ms": { "$ref": "#/$defs/non_negative_number" },
        "t7_max_transaction_duration_ms": { "$ref": "#/$defs/non_negative_number" },
        "t8_max_transaction_duration_ms": { "$ref": "#/$defs/non_negative_number" },
        "certified_at_ms": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "runtime_supported_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "max_scopes_total",
        "max_nodes_total",
        "max_edges_total",
        "max_attempts_total",
        "max_waits_total",
        "max_builds_total",
        "max_effect_operations_total",
        "max_facts_per_transaction",
        "max_frontier_bytes",
        "max_subtree_scopes_per_fence",
        "max_subtree_nodes_per_fence",
        "max_subtree_edges_per_fence",
        "max_subtree_attempts_per_fence",
        "max_subtree_waits_per_fence",
        "max_subtree_builds_per_fence",
        "max_subtree_map_slots_per_fence",
        "max_subtree_effects_per_fence",
        "max_t7_derived_facts_per_fence",
        "max_subtree_fence_manifest_bytes",
        "max_map_items_total",
        "max_required_child_creations_per_t8",
        "certification",
        "profile_hash"
      ],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "max_scopes_total": { "const": 128 },
        "max_nodes_total": { "const": 1024 },
        "max_edges_total": { "const": 4096 },
        "max_attempts_total": { "const": 4096 },
        "max_waits_total": { "const": 512 },
        "max_builds_total": { "const": 512 },
        "max_effect_operations_total": { "const": 2048 },
        "max_facts_per_transaction": { "const": 16384 },
        "max_frontier_bytes": { "const": 16777216 },
        "max_subtree_scopes_per_fence": { "const": 128 },
        "max_subtree_nodes_per_fence": { "const": 1024 },
        "max_subtree_edges_per_fence": { "const": 4096 },
        "max_subtree_attempts_per_fence": { "const": 4096 },
        "max_subtree_waits_per_fence": { "const": 512 },
        "max_subtree_builds_per_fence": { "const": 512 },
        "max_subtree_map_slots_per_fence": { "const": 256 },
        "max_subtree_effects_per_fence": { "const": 2048 },
        "max_t7_derived_facts_per_fence": { "const": 16384 },
        "max_subtree_fence_manifest_bytes": { "const": 16777216 },
        "max_map_items_total": { "const": 256 },
        "max_required_child_creations_per_t8": { "const": 8 },
        "certification": { "$ref": "#/$defs/limit_certification" },
        "profile_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "certification_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_profile",
        "runtime_surface",
        "platform",
        "arch",
        "release_manifest_hash",
        "release_artifact_hash",
        "core_build_hash",
        "database_schema_hash",
        "runtime_launcher_hash",
        "runtime_toolchain_hash",
        "managed_node_distribution_ref",
        "managed_node_distribution_hash",
        "node_runtime_version",
        "node_executable_hash",
        "better_sqlite3_version",
        "better_sqlite3_native_module_hash",
        "sqlite_version",
        "sqlite_source_id",
        "sqlite_compile_options_hash",
        "sqlite_execution_profile_ref",
        "sqlite_execution_profile_hash",
        "benchmark_harness_ref",
        "benchmark_harness_version",
        "benchmark_harness_hash",
        "benchmark_observation_hash",
        "limit_derivation_ref",
        "limit_derivation_hash",
        "runtime_supported_limits_ref",
        "runtime_supported_limits_hash",
        "product_floor_ref",
        "product_floor_hash",
        "minimum_machine_class_ref",
        "minimum_machine_class_hash",
        "minimum_machine_observation_hash",
        "startup_smoke_harness_ref",
        "startup_smoke_harness_hash",
        "startup_smoke_report_hash"
      ],
      "properties": {
        "deployment_profile": { "const": "local_single_user" },
        "runtime_surface": { "const": "node_service" },
        "platform": { "const": "darwin" },
        "arch": { "const": "arm64" },
        "release_manifest_hash": { "$ref": "#/$defs/hash" },
        "release_artifact_hash": { "$ref": "#/$defs/hash" },
        "core_build_hash": { "$ref": "#/$defs/hash" },
        "database_schema_hash": { "$ref": "#/$defs/hash" },
        "runtime_launcher_hash": { "$ref": "#/$defs/hash" },
        "runtime_toolchain_hash": { "$ref": "#/$defs/hash" },
        "managed_node_distribution_ref": { "$ref": "#/$defs/ref" },
        "managed_node_distribution_hash": { "$ref": "#/$defs/hash" },
        "node_runtime_version": { "const": "26.5.0" },
        "node_executable_hash": { "$ref": "#/$defs/hash" },
        "better_sqlite3_version": { "const": "12.11.1" },
        "better_sqlite3_native_module_hash": { "$ref": "#/$defs/hash" },
        "sqlite_version": { "type": "string", "minLength": 1 },
        "sqlite_source_id": { "type": "string", "minLength": 1 },
        "sqlite_compile_options_hash": { "$ref": "#/$defs/hash" },
        "sqlite_execution_profile_ref": { "$ref": "#/$defs/ref" },
        "sqlite_execution_profile_hash": { "$ref": "#/$defs/hash" },
        "benchmark_harness_ref": { "$ref": "#/$defs/ref" },
        "benchmark_harness_version": { "const": "1.0.0" },
        "benchmark_harness_hash": { "$ref": "#/$defs/hash" },
        "benchmark_observation_hash": { "$ref": "#/$defs/hash" },
        "limit_derivation_ref": { "$ref": "#/$defs/ref" },
        "limit_derivation_hash": { "$ref": "#/$defs/hash" },
        "runtime_supported_limits_ref": { "$ref": "#/$defs/ref" },
        "runtime_supported_limits_hash": { "$ref": "#/$defs/hash" },
        "product_floor_ref": { "$ref": "#/$defs/ref" },
        "product_floor_hash": { "$ref": "#/$defs/hash" },
        "minimum_machine_class_ref": { "$ref": "#/$defs/ref" },
        "minimum_machine_class_hash": { "$ref": "#/$defs/hash" },
        "minimum_machine_observation_hash": { "$ref": "#/$defs/hash" },
        "startup_smoke_harness_ref": { "$ref": "#/$defs/ref" },
        "startup_smoke_harness_hash": { "$ref": "#/$defs/hash" },
        "startup_smoke_report_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "certification_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "ref",
        "version",
        "status",
        "certification_key",
        "certification_key_hash",
        "certified_at_ms",
        "security_sensitive_validation",
        "security_validation_basis",
        "pack_hash"
      ],
      "properties": {
        "format": { "const": "icarus.workflow-runtime-certification-pack/1" },
        "ref": { "$ref": "#/$defs/ref" },
        "version": { "const": 1 },
        "status": { "const": "certified" },
        "certification_key": { "$ref": "#/$defs/certification_key" },
        "certification_key_hash": { "$ref": "#/$defs/hash" },
        "certified_at_ms": { "$ref": "#/$defs/positive_integer" },
        "security_sensitive_validation": { "const": "SECURITY_VALIDATION_NOT_RUN" },
        "security_validation_basis": {
          "const": "static_source_existing_tests_and_invariant_mapping_only"
        },
        "pack_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
