{
  "format": "icarus.workflow-feature-manifest-v2-schema/1",
  "ref": {
    "id": "icarus.workflow-feature-manifest-v2-schema",
    "version": "1.0.0"
  },
  "version": 1,
  "domain_separator": "icarus:workflow-feature-manifest-v2-schema:1\n",
  "hash": "sha256:e47344ea2f4bebde3688f76b3450d5143adfd99ab4cc30eb6fc48a9d5a398e2d",
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://icarus.local/schemas/feature-manifest/2",
    "title": "FeatureManifestVNext",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "feature_ref",
      "namespace",
      "owner_principal_ref",
      "dependencies",
      "package_resources",
      "extension_surfaces",
      "dynamic_workflow_resources",
      "ownership",
      "lifecycle",
      "manifest_hash"
    ],
    "properties": {
      "format": {
        "const": "icarus.feature-manifest/2"
      },
      "feature_ref": {
        "$ref": "#/$defs/versioned_ref"
      },
      "namespace": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
      },
      "owner_principal_ref": {
        "type": "string",
        "minLength": 1
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature_release_ref",
            "feature_release_hash",
            "required_resource_refs"
          ],
          "properties": {
            "feature_release_ref": {
              "$ref": "#/$defs/versioned_ref"
            },
            "feature_release_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "required_resource_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/versioned_ref"
              },
              "uniqueItems": true
            }
          }
        }
      },
      "package_resources": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skills",
          "agents",
          "mcp",
          "scripts",
          "templates"
        ],
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "mcp": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "extension_surfaces": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_entry",
          "nav_entry",
          "renderer_entry"
        ],
        "properties": {
          "api_entry": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "nav_entry": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "renderer_entry": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "dynamic_workflow_resources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref",
            "source_path",
            "expected_source_hash"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "recipe",
                "routing_scope",
                "routing_capability",
                "clarification_contract",
                "execution_policy",
                "definition",
                "command_policy",
                "operational_remediation_policy",
                "context_contract",
                "schema",
                "scope_interface",
                "graph_template",
                "graph_policy",
                "capability",
                "executor_implementation",
                "prompt",
                "tool_binding",
                "wait_contract",
                "notification_contract",
                "card_presentation",
                "artifact_contract",
                "evaluator",
                "root_finalization_policy",
                "outbox_policy"
              ]
            },
            "ref": {
              "$ref": "#/$defs/versioned_ref"
            },
            "source_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "expected_source_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      },
      "ownership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_source_root",
          "workflow_source_root",
          "execution_bundle_owner",
          "registry_namespace"
        ],
        "properties": {
          "feature_source_root": {
            "type": "string",
            "minLength": 1
          },
          "workflow_source_root": {
            "type": "string",
            "minLength": 1
          },
          "execution_bundle_owner": {
            "const": "feature_release"
          },
          "registry_namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
          }
        }
      },
      "lifecycle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draining_policy_ref",
          "retention_policy_ref",
          "deletion_policy_ref"
        ],
        "properties": {
          "draining_policy_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "retention_policy_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "deletion_policy_ref": {
            "$ref": "#/$defs/versioned_ref"
          }
        }
      },
      "manifest_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "$defs": {
      "versioned_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$",
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Hh][Ee][Aa][Dd]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Mm][Aa][Ii][Nn]|[Mm][Aa][Ss][Tt][Ee][Rr]|[Nn][Ee][Xx][Tt]|[Ss][Nn][Aa][Pp][Ss][Hh][Oo][Tt])$"
                },
                {
                  "pattern": "(?:^|[._-])[xX](?:$|[._-])"
                }
              ]
            }
          }
        }
      },
      "json_value": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/json_value"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/json_value"
            }
          }
        ]
      }
    }
  }
}
