diff --git a/lib/core/infra/icarus_trace.dart b/lib/core/infra/icarus_trace.dart
new file mode 100644
--- /dev/null
+++ b/lib/core/infra/icarus_trace.dart
@@ -0,0 +1,258 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:dio/dio.dart';
+import 'package:flutter/foundation.dart';
+import 'package:path_provider/path_provider.dart';
+
+class IcarusTrace {
+  static const _buildTimeNetworkLogEnabled = String.fromEnvironment(
+    'ICARUS_NETWORK_LOG_ENABLED',
+    defaultValue: '',
+  );
+  static const _buildTimeUiTestMode = String.fromEnvironment(
+    'UITestMode',
+    defaultValue: '',
+  );
+
+  static bool get enabled {
+    return _truthy(_buildTimeNetworkLogEnabled) ||
+        _truthy(_buildTimeUiTestMode) ||
+        _truthy(Platform.environment['ICARUS_NETWORK_LOG_ENABLED']) ||
+        _truthy(Platform.environment['UITestMode']);
+  }
+
+  static Future<File> _file(String relativePath) async {
+    final dir = await getApplicationCacheDirectory();
+    final file = File('${dir.path}/$relativePath');
+    await file.parent.create(recursive: true);
+    if (!await file.exists()) {
+      await file.create(recursive: true);
+    }
+    return file;
+  }
+
+  static Future<void> ensureTraceFiles() async {
+    if (!enabled) return;
+    await Future.wait([
+      _file('IcarusNetworkLog/network.jsonl'),
+      _file('IcarusAppLog/app.log'),
+      _file('IcarusCrashLog/crash.log'),
+    ]);
+  }
+
+  static void appendAppLog(String line) {
+    if (!enabled) return;
+    unawaited(_append('IcarusAppLog/app.log', line));
+  }
+
+  static void recordCrash(
+    Object error,
+    StackTrace? stackTrace, {
+    String source = 'unknown',
+  }) {
+    if (!enabled) return;
+    final payload = {
+      'timestamp': DateTime.now().toUtc().toIso8601String(),
+      'source': source,
+      'error': _redactText(error.toString()),
+      'stack': _redactText(stackTrace?.toString() ?? ''),
+    };
+    unawaited(_append('IcarusCrashLog/crash.log', jsonEncode(payload)));
+  }
+
+  static Future<void> appendNetworkEvent(Map<String, dynamic> event) {
+    if (!enabled) return Future.value();
+    try {
+      return _append(
+        'IcarusNetworkLog/network.jsonl',
+        _safeJsonEncode(_redactJson(event)),
+      );
+    } catch (e) {
+      if (kDebugMode) {
+        debugPrint('[IcarusTrace] network event encode failed: $e');
+      }
+      return Future.value();
+    }
+  }
+
+  static Future<void> _append(String relativePath, String line) async {
+    try {
+      final file = await _file(relativePath);
+      await file.writeAsString('$line\n', mode: FileMode.append, flush: true);
+    } catch (e) {
+      if (kDebugMode) {
+        debugPrint('[IcarusTrace] write failed: $e');
+      }
+    }
+  }
+
+  static dynamic _summary(dynamic value) {
+    if (value == null) return null;
+    if (value is FormData) {
+      return {
+        'type': 'form_data',
+        'fields': value.fields.map((item) => item.key).toList(),
+        'files': value.files.map((item) => item.key).toList(),
+      };
+    }
+    if (value is Map ||
+        value is List ||
+        value is String ||
+        value is num ||
+        value is bool) {
+      return _truncate(_redactJson(value));
+    }
+    return {'type': value.runtimeType.toString()};
+  }
+
+  static dynamic _truncate(dynamic value) {
+    final text = _safeJsonEncode(value);
+    if (text.length <= 2000) return value;
+    return {
+      'truncated': true,
+      'preview': text.substring(0, 2000),
+    };
+  }
+
+  static dynamic _redactJson(dynamic value) {
+    if (value is Map) {
+      return value.map((key, child) {
+        final keyText = key.toString();
+        if (_sensitiveKey(keyText)) {
+          return MapEntry(key, '[REDACTED]');
+        }
+        return MapEntry(key, _redactJson(child));
+      });
+    }
+    if (value is List) return value.map(_redactJson).toList();
+    if (value is String) return _redactText(value);
+    return value;
+  }
+
+  static String _safeJsonEncode(dynamic value) {
+    return jsonEncode(value, toEncodable: (object) {
+      return object?.toString();
+    });
+  }
+
+  static bool _truthy(String? value) {
+    if (value == null) return false;
+    final normalized = value.toLowerCase();
+    return normalized == '1' ||
+        normalized == 'true' ||
+        normalized == 'yes' ||
+        normalized == 'on';
+  }
+
+  static bool _sensitiveKey(String key) {
+    final normalized = key.toLowerCase();
+    return normalized.contains('token') ||
+        normalized.contains('authorization') ||
+        normalized.contains('cookie') ||
+        normalized.contains('password') ||
+        normalized.contains('secret') ||
+        normalized.contains('phone') ||
+        normalized.contains('mobile') ||
+        normalized.contains('idcard') ||
+        normalized.contains('identity') ||
+        normalized.contains('lat') ||
+        normalized.contains('lng') ||
+        normalized.contains('longitude') ||
+        normalized.contains('latitude');
+  }
+
+  static String _redactText(String value) {
+    var out = value;
+    out = out.replaceAll(
+      RegExp(r'Bearer\s+[A-Za-z0-9._~+/=-]+'),
+      'Bearer [REDACTED]',
+    );
+    out = out.replaceAll(RegExp(r'1[3-9]\d{9}'), '[PHONE_REDACTED]');
+    out = out.replaceAll(RegExp(r'\b\d{17}[\dXx]\b'), '[IDCARD_REDACTED]');
+    return out;
+  }
+}
+
+class IcarusTraceInterceptor extends Interceptor {
+  @override
+  void onRequest(RequestOptions options, RequestInterceptorHandler handler) {
+    options.extra['icarus_started_ms'] = DateTime.now().millisecondsSinceEpoch;
+    options.extra['icarus_started_at'] =
+        DateTime.now().toUtc().toIso8601String();
+    handler.next(options);
+  }
+
+  @override
+  void onResponse(Response response, ResponseInterceptorHandler handler) {
+    _writeResponse(response);
+    handler.next(response);
+  }
+
+  @override
+  void onError(DioException err, ErrorInterceptorHandler handler) {
+    _writeError(err);
+    handler.next(err);
+  }
+
+  void _writeResponse(Response response) {
+    final request = response.requestOptions;
+    final startedMs = request.extra['icarus_started_ms'];
+    final now = DateTime.now();
+    final startedAt =
+        request.extra['icarus_started_at']?.toString() ??
+        now.toUtc().toIso8601String();
+    final latency = startedMs is int
+        ? now.millisecondsSinceEpoch - startedMs
+        : null;
+    unawaited(
+      IcarusTrace.appendNetworkEvent({
+        'timestamp': now.toUtc().toIso8601String(),
+        'started_at': startedAt,
+        'method': request.method,
+        'url': request.uri.toString(),
+        'path': request.uri.path,
+        'base_url': request.baseUrl,
+        'status': response.statusCode,
+        'latency_ms': latency,
+        'request_summary': {
+          'query': IcarusTrace._summary(request.queryParameters),
+          'body': IcarusTrace._summary(request.data),
+        },
+        'response_summary': IcarusTrace._summary(response.data),
+      }),
+    );
+  }
+
+  void _writeError(DioException err) {
+    final request = err.requestOptions;
+    final startedMs = request.extra['icarus_started_ms'];
+    final now = DateTime.now();
+    final startedAt =
+        request.extra['icarus_started_at']?.toString() ??
+        now.toUtc().toIso8601String();
+    final latency = startedMs is int
+        ? now.millisecondsSinceEpoch - startedMs
+        : null;
+    unawaited(
+      IcarusTrace.appendNetworkEvent({
+        'timestamp': now.toUtc().toIso8601String(),
+        'started_at': startedAt,
+        'method': request.method,
+        'url': request.uri.toString(),
+        'path': request.uri.path,
+        'base_url': request.baseUrl,
+        'status': err.response?.statusCode,
+        'latency_ms': latency,
+        'error': IcarusTrace._redactText(err.message ?? err.type.toString()),
+        'request_summary': {
+          'query': IcarusTrace._summary(request.queryParameters),
+          'body': IcarusTrace._summary(request.data),
+        },
+        'response_summary': IcarusTrace._summary(err.response?.data),
+      }),
+    );
+  }
+}
