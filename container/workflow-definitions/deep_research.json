{
  "key": "deep_research",
  "label": "Deep Research",
  "description": "基于公开网页检索、证据抽取和引用校验生成正式深度研究报告。",
  "versions": [
    {
      "key": "deep_research",
      "name": "Deep Research",
      "description": "多阶段公开网页研究流程。",
      "version": 1,
      "status": "published",
      "roles": {
        "planner": {
          "label": "研究规划",
          "deliverable_file": "research_plan.json",
          "channels": {
            "web": "web_research_planner"
          }
        },
        "collector": {
          "label": "来源收集",
          "deliverable_file": "sources.json",
          "channels": {
            "web": "web_research_collector"
          }
        },
        "analyst": {
          "label": "证据分析",
          "deliverable_file": "findings.json",
          "channels": {
            "web": "web_research_analyst"
          }
        },
        "writer": {
          "label": "报告生成",
          "deliverable_file": "report.json",
          "channels": {
            "web": "web_research_writer"
          }
        },
        "reviewer": {
          "label": "引用审查",
          "deliverable_file": "review.json",
          "channels": {
            "web": "web_research_reviewer"
          }
        }
      },
      "artifacts": [
        {
          "artifact_type": "research_plan",
          "title": "研究计划",
          "path": "research_plan.json",
          "source_role": "planner",
          "required": true
        },
        {
          "artifact_type": "research_sources",
          "title": "来源清单",
          "path": "sources.json",
          "source_role": "collector",
          "required": true
        },
        {
          "artifact_type": "research_search_log",
          "title": "检索记录",
          "path": "search_log.json",
          "source_role": "collector",
          "required": true
        },
        {
          "artifact_type": "research_source_review",
          "title": "来源充分性审核",
          "path": "source_review.json",
          "source_role": "reviewer",
          "required": true
        },
        {
          "artifact_type": "research_evidence",
          "title": "证据卡片",
          "path": "evidence.json",
          "source_role": "analyst",
          "required": true
        },
        {
          "artifact_type": "research_findings",
          "title": "发现清单",
          "path": "findings.json",
          "source_role": "analyst",
          "required": true
        },
        {
          "artifact_type": "research_evidence_review",
          "title": "证据抽取审核",
          "path": "evidence_review.json",
          "source_role": "reviewer",
          "required": true
        },
        {
          "artifact_type": "research_report_bundle",
          "title": "正式研究报告数据",
          "path": "report.json",
          "source_role": "writer",
          "required": true
        },
        {
          "artifact_type": "research_review",
          "title": "报告引用审查",
          "path": "review.json",
          "source_role": "reviewer",
          "required": true
        },
        {
          "artifact_type": "traceability",
          "title": "追踪矩阵",
          "path": "traceability.json",
          "required": true
        },
        {
          "artifact_type": "research_markdown_export",
          "title": "Markdown 导出",
          "path": "exports/report.md"
        },
        {
          "artifact_type": "research_print_export",
          "title": "PDF 打印页",
          "path": "exports/report.html"
        }
      ],
      "entry_points": {
        "plan": {
          "label": "开始研究",
          "state": "plan"
        }
      },
      "states": {
        "plan": {
          "type": "delegation",
          "label": "研究规划",
          "artifact_contract": {
            "ref": "deep_research.plan.v1"
          },
          "evaluator": {
            "ref": "deep_research.plan.v1"
          },
          "delegate": {
            "role": "planner",
            "skill": "deep-research-plan",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n研究深度：{{depth}}\n来源范围：{{source_scope}}\n报告语言：{{language}}\n报告风格：{{report_style}}\n来源限制：{{source_limits}}\n约束与排除：{{constraints}}\n历史研究上下文：{{previous_research_context}}\n服务名称：{{service}}\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n如果历史研究上下文非空，请将其中的历史研究问题、各阶段产物和最终产物作为参考，规划本次围绕当前研究问题的续研范围；不要把历史结论直接当作新结论。请输出 research_plan.json 和 traceability.json 初始版本，并调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.plan.input.v1",
              "output_schema": "deep_research.plan.v1",
              "artifact_contract_ref": "deep_research.plan.v1",
              "success_criteria": [
                "research_plan.json 写入交付目录",
                "traceability.json 写入交付目录",
                "返回 deliverable、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "collect"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "collect": {
          "type": "delegation",
          "label": "来源收集",
          "artifact_contract": {
            "ref": "deep_research.collect.v1"
          },
          "evaluator": {
            "ref": "deep_research.collect.v1"
          },
          "delegate": {
            "role": "collector",
            "skill": "deep-research-collect",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n历史研究上下文：{{previous_research_context}}\n研究计划：/workspace/projects/{{service}}/iteration/{{deliverable}}/research_plan.json\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n请只检索公开网页，使用 WebSearch、WebFetch、agent-browser，并在 delegation 内部使用 SDK agent team 并行探索。若历史研究上下文非空，应优先补足当前问题相对历史产物的缺口和新证据。输出 sources.json、search_log.json 并更新 traceability.json，然后调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.collect.input.v1",
              "output_schema": "deep_research.collect.v1",
              "artifact_contract_ref": "deep_research.collect.v1",
              "success_criteria": [
                "sources.json 至少包含公开网页来源",
                "search_log.json 记录查询、候选、入选和剔除原因",
                "不编造 URL、标题、发布时间或来源",
                "返回 deliverable、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "collect_review"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "collect_review": {
          "type": "delegation",
          "label": "来源审核",
          "artifact_contract": {
            "ref": "deep_research.collect_review.v1"
          },
          "evaluator": {
            "ref": "deep_research.collect_review.v1",
            "on_pass": {
              "target": "analyze"
            },
            "on_needs_revision": {
              "target": "collect"
            },
            "on_fail": {
              "target": "failed"
            },
            "on_pending": {
              "target": "collect_review"
            }
          },
          "delegate": {
            "role": "reviewer",
            "skill": "deep-research-collect-review",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n历史研究上下文：{{previous_research_context}}\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n请审核 research_plan.json、sources.json、search_log.json 和 traceability.json，判断来源是否覆盖研究计划子问题、是否缺官方/一手/关键来源、来源是否过旧/重复/低质量、检索记录是否说明候选和剔除原因。输出 source_review.json。source_review.json verdict 可为 passed、needs_revision、failed、pending；route 可为 collect、analyze、failed、collect_review。若需要补来源，verdict=needs_revision 且 route=collect。然后调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.collect_review.input.v1",
              "output_schema": "deep_research.collect_review.v1",
              "artifact_contract_ref": "deep_research.collect_review.v1",
              "success_criteria": [
                "source_review.json 写入交付目录",
                "审核来源覆盖 research_plan.json 子问题",
                "审核 sources/search_log 的公开网页质量和检索记录完整性",
                "返回 deliverable、verdict、route、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "analyze"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "analyze": {
          "type": "delegation",
          "label": "证据分析",
          "artifact_contract": {
            "ref": "deep_research.analyze.v1"
          },
          "evaluator": {
            "ref": "deep_research.analyze.v1"
          },
          "delegate": {
            "role": "analyst",
            "skill": "deep-research-analyze",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n历史研究上下文：{{previous_research_context}}\n来源清单：/workspace/projects/{{service}}/iteration/{{deliverable}}/sources.json\n检索记录：/workspace/projects/{{service}}/iteration/{{deliverable}}/search_log.json\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n请抽取 evidence.json、findings.json，更新 traceability.json；如果历史研究上下文非空，需要明确哪些发现继承为背景、哪些由本次新证据支撑、哪些被修正或推翻。然后调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.analyze.input.v1",
              "output_schema": "deep_research.analyze.v1",
              "artifact_contract_ref": "deep_research.analyze.v1",
              "success_criteria": [
                "evidence.json 每条证据绑定 source_id",
                "findings.json 每条发现绑定 evidence 和 sources",
                "冲突点、缺口和不确定性显式记录",
                "返回 deliverable、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "analyze_review"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "analyze_review": {
          "type": "delegation",
          "label": "证据审核",
          "artifact_contract": {
            "ref": "deep_research.analyze_review.v1"
          },
          "evaluator": {
            "ref": "deep_research.analyze_review.v1",
            "on_pass": {
              "target": "write"
            },
            "on_needs_revision": {
              "target": "analyze"
            },
            "on_fail": {
              "target": "failed"
            },
            "on_pending": {
              "target": "analyze_review"
            }
          },
          "delegate": {
            "role": "reviewer",
            "skill": "deep-research-analyze-review",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n历史研究上下文：{{previous_research_context}}\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n请审核 sources.json、evidence.json、findings.json 和 traceability.json，判断 evidence 是否正确引用 sources、findings 是否正确引用 evidence/source、是否漏掉关键证据、是否保留冲突/限制/不确定性。输出 evidence_review.json。evidence_review.json verdict 可为 passed、needs_revision、failed、pending；route 可为 collect、analyze、write、failed、analyze_review。若来源本身不足，route=collect；若只是证据抽取或发现归纳问题，route=analyze。然后调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.analyze_review.input.v1",
              "output_schema": "deep_research.analyze_review.v1",
              "artifact_contract_ref": "deep_research.analyze_review.v1",
              "success_criteria": [
                "evidence_review.json 写入交付目录",
                "校验 evidence/source 和 finding/evidence/source 映射",
                "区分来源不足 route=collect 与证据抽取问题 route=analyze",
                "返回 deliverable、verdict、route、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "write"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "write": {
          "type": "delegation",
          "label": "报告生成",
          "artifact_contract": {
            "ref": "deep_research.write.v1"
          },
          "evaluator": {
            "ref": "deep_research.write.v1"
          },
          "delegate": {
            "role": "writer",
            "skill": "deep-research-write",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n报告语言：{{language}}\n报告风格：{{report_style}}\n历史研究上下文：{{previous_research_context}}\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n请只基于本次 research_plan.json、sources.json、evidence.json、findings.json 写一份正式、可直接交付阅读的结构化 report.json。报告必须有执行摘要、方法与数据口径、关键表格或判断矩阵、主体产研/市场分析、风险限制和建议/后续补证；TopN/榜单/竞品类研究要优先输出 candidate_top10 或 table block。正文必须是分析报告写法，不要把证据清单、URL、来源标题、SRC/EVID 编号或“引用/证据/来源显示”堆进 text/body；引用只放在 citations/source_ids 字段中，系统导出时会统一生成脚注/附录。历史研究上下文仅作为背景和对比线索，不得替代本次引用证据。不输出任意 HTML/CSS/JS，并调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.write.input.v1",
              "output_schema": "deep_research.write.v1",
              "artifact_contract_ref": "deep_research.write.v1",
              "success_criteria": [
                "report.json 符合正式研究报告 schema",
                "报告包含执行摘要、方法口径、关键表格/判断矩阵、主体分析、风险限制和建议/补证",
                "正文不堆叠 URL、来源标题、SRC/EVID 编号或证据话术",
                "关键 claim 使用 sources.json 中存在的 source id 引用",
                "Markdown 不是主产物",
                "返回 deliverable、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "review"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "review": {
          "type": "delegation",
          "label": "报告引用审查",
          "artifact_contract": {
            "ref": "deep_research.review.v1"
          },
          "evaluator": {
            "ref": "deep_research.review.v1",
            "on_pass": {
              "target": "publish"
            },
            "on_needs_revision": {
              "target": "write"
            },
            "on_fail": {
              "target": "failed"
            },
            "on_pending": {
              "target": "review"
            }
          },
          "delegate": {
            "role": "reviewer",
            "skill": "deep-research-review",
            "task_template": "流程类型：{{workflow_type}}\n研究问题：{{research_query}}\n历史研究上下文：{{previous_research_context}}\n交付目录：/workspace/projects/{{service}}/iteration/{{deliverable}}\n\n请校验 report.json、sources.json、evidence.json、findings.json、source_review.json、evidence_review.json 和 traceability.json，输出 review.json。除引用正确性外，还必须审核 report.json 是否是一份正式、可直接阅读的研究报告：是否有执行摘要、方法口径、关键表格/判断矩阵、主体产研/市场分析、风险限制和建议/补证；正文是否避免堆叠 URL、来源标题、SRC/EVID 编号和证据话术。若报告使用了历史研究上下文中的结论，必须确认其被本次 sources/evidence 支撑或被标注为背景。review.json verdict 可为 passed、needs_revision、failed、pending，route 可为 collect、analyze、write、failed、publish、review；route 会被 workflow 执行：报告证据正确但不像正式报告/干货不足/正文引用过载回 write，证据抽取问题回 analyze，来源不足回 collect。然后调用 complete_delegation。",
            "handoff": {
              "input_schema": "deep_research.review.input.v1",
              "output_schema": "deep_research.review.v1",
              "artifact_contract_ref": "deep_research.review.v1",
              "success_criteria": [
                "review.json 写入交付目录",
                "校验每个关键 claim 是否有来源支撑",
                "校验引用是否只指向存在的 source/evidence",
                "校验正式报告结构、干货密度和正文引用克制",
                "返回 deliverable、verdict、route、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "publish"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "publish": {
          "type": "system",
          "label": "导出发布",
          "run": {
            "steps": [
              {
                "id": "export_report",
                "uses": "deep_research.export"
              }
            ]
          },
          "on_complete": {
            "success": {
              "target": "passed"
            },
            "failure": {
              "target": "failed"
            }
          }
        },
        "passed": {
          "type": "terminal",
          "label": "研究完成"
        },
        "failed": {
          "type": "terminal",
          "label": "研究失败"
        }
      },
      "status_labels": {
        "plan": "研究规划",
        "collect": "来源收集",
        "collect_review": "来源审核",
        "analyze": "证据分析",
        "analyze_review": "证据审核",
        "write": "报告生成",
        "review": "报告引用审查",
        "publish": "导出发布",
        "passed": "研究完成",
        "failed": "研究失败"
      },
      "create_form": {
        "fields": [
          {
            "key": "research_query",
            "label": "研究问题",
            "type": "textarea",
            "required": true
          },
          {
            "key": "depth",
            "label": "研究深度",
            "type": "choice",
            "default_value": "deep",
            "options": [
              {
                "value": "quick",
                "label": "快速"
              },
              {
                "value": "standard",
                "label": "标准"
              },
              {
                "value": "deep",
                "label": "深入"
              }
            ]
          },
          {
            "key": "source_scope",
            "label": "来源范围",
            "type": "choice",
            "default_value": "public_web",
            "options": [
              {
                "value": "public_web",
                "label": "公开网页"
              }
            ]
          },
          {
            "key": "language",
            "label": "报告语言",
            "type": "choice",
            "default_value": "zh",
            "options": [
              {
                "value": "zh",
                "label": "中文"
              },
              {
                "value": "en",
                "label": "英文"
              },
              {
                "value": "auto",
                "label": "自动"
              }
            ]
          },
          {
            "key": "report_style",
            "label": "报告风格",
            "type": "choice",
            "default_value": "deep_report",
            "options": [
              {
                "value": "interactive",
                "label": "交互式报告"
              },
              {
                "value": "deep_report",
                "label": "深度报告"
              },
              {
                "value": "comparison",
                "label": "对比分析"
              }
            ]
          },
          {
            "key": "constraints",
            "label": "限制条件",
            "type": "textarea",
            "required": false
          }
        ]
      }
    }
  ]
}
