{
  "key": "dev_test",
  "label": "开发测试流程",
  "description": "需求从方案设计、开发、复核、预发部署到测试通过的标准流程。",
  "versions": [
    {
      "key": "dev_test",
      "name": "开发测试流程",
      "description": "需求从方案设计、开发、复核、预发部署到测试通过的标准流程。",
      "version": 1,
      "status": "published",
      "roles": {
        "planner": {
          "label": "方案设计",
          "deliverable_file": "plan.md",
          "channels": {
            "web": "web_plan"
          }
        },
        "plan_examiner": {
          "label": "方案审核",
          "channels": {
            "web": "web_plan_examine"
          }
        },
        "dev": {
          "label": "开发",
          "deliverable_file": "dev.md",
          "channels": {
            "web": "web_dev"
          }
        },
        "dev_examiner": {
          "label": "开发复核",
          "channels": {
            "web": "web_dev_examine"
          }
        },
        "ops": {
          "label": "运维",
          "channels": {
            "web": "web_ops"
          }
        },
        "test": {
          "label": "测试",
          "deliverable_file": "test.md",
          "channels": {
            "web": "web_test"
          }
        }
      },
      "entry_points": {
        "plan": {
          "label": "从方案开始",
          "state": "plan"
        },
        "dev": {
          "label": "从开发开始",
          "state": "dev",
          "requires_deliverable": true,
          "deliverable_role": "planner",
          "manual_requirement_create": {
            "enabled": true,
            "files": [
              {
                "filename": "plan.md",
                "label": "方案文档",
                "required": true
              }
            ]
          }
        },
        "testing": {
          "label": "从测试前确认开始",
          "state": "awaiting_confirm",
          "requires_deliverable": true,
          "deliverable_role": "dev",
          "manual_requirement_create": {
            "enabled": true,
            "files": [
              {
                "filename": "dev.md",
                "label": "开发文档",
                "required": true
              },
              {
                "filename": "plan.md",
                "label": "方案文档",
                "required": false
              }
            ]
          }
        }
      },
      "states": {
        "plan": {
          "type": "delegation",
          "label": "方案设计",
          "artifact_contract": {
            "ref": "dev_test.plan.v1"
          },
          "evaluator": {
            "ref": "dev_test.plan.v1"
          },
          "context_requirements": {
            "readiness_policy": "record_only",
            "sources": [
              {
                "id": "user_input",
                "type": "workflow_input",
                "required": true,
                "fields": [
                  "requirement_description",
                  "requirement_files",
                  "main_branch",
                  "work_branch"
                ]
              },
              {
                "id": "service_codebase_location",
                "type": "codebase_location",
                "required": false,
                "fields": [
                  "repo_path",
                  "container_path"
                ],
                "verify_exists": true,
                "verify_mounted_for_role": true
              }
            ]
          },
          "quality_gate": {
            "pass_policy": "all_blocking_pass",
            "evaluators": [
              {
                "type": "schema",
                "blocking": true
              },
              {
                "type": "artifact",
                "blocking": true
              },
              {
                "type": "stage_rules",
                "blocking": true
              },
              {
                "type": "context_coverage",
                "blocking": true
              },
              {
                "type": "evidence",
                "blocking": true
              },
              {
                "type": "consistency",
                "blocking": true
              },
              {
                "type": "llm_judge",
                "blocking": false
              }
            ]
          },
          "delegate": {
            "role": "planner",
            "skill": "plan-requirement",
            "task_template": "流程类型：{{workflow_type}}\n请为以下需求设计实现方案：\n\n需求描述：{{requirement_description}}\n附件文件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}",
            "handoff": {
              "input_schema": "workflow.plan.input.v1",
              "output_schema": "dev_test.plan.v1",
              "artifact_contract_ref": "dev_test.plan.v1",
              "success_criteria": [
                "方案文档写入指定交付目录",
                "返回 deliverable、main_branch、work_branch",
                "返回 verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "plan_examine",
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 方案设计完成，已委派 {{role_folder:plan_examiner}} 进行方案审核。"
              }
            },
            "failure": {
              "target": "plan",
              "notify": {
                "template": "[流程异常] 需求「{{name}}」({{id}}) 方案设计失败，请检查。"
              }
            }
          }
        },
        "plan_examine": {
          "type": "delegation",
          "label": "方案审核",
          "evaluator": {
            "ref": "dev_test.plan_review.v1"
          },
          "delegate": {
            "role": "plan_examiner",
            "skill": "plan-examine",
            "task_template": "流程类型：{{workflow_type}}\n请审核以下需求方案并给出结论与修改建议：\n\n需求名称：{{name}}\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n方案文件：{{plan_doc}}",
            "handoff": {
              "input_schema": "workflow.review.input.v1",
              "output_schema": "dev_test.plan.v1",
              "artifact_contract_ref": "dev_test.plan.v1",
              "success_criteria": [
                "完成方案复核",
                "返回明确 review verdict",
                "findings 和 evidence 支撑复核结论"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "dev",
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 方案审核通过，已自动进入开发阶段，已委派 {{role_folder:dev}} 开始执行。"
              }
            },
            "failure": {
              "target": "plan_examine_confirm",
              "card": {
                "ref": "plan_examine_confirm"
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 方案审核未通过 ❌\n\n{{result_summary}}\n\n请确认：直接继续后续流程，或回到 Plan 按意见修改。"
              }
            }
          }
        },
        "plan_examine_confirm": {
          "type": "interrupt",
          "label": "方案复核审批",
          "card": {
            "ref": "plan_examine_confirm"
          },
          "kind": "approval",
          "title": "方案复核审批",
          "allowed_actions": [
            "approve",
            "revise"
          ],
          "resume_payload_schema": {
            "schema": {
              "type": "object",
              "properties": {
                "revision_text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "on_resume": {
            "approve": {
              "target": "dev",
              "delegate": {
                "role": "dev",
                "skill": "dev-requirement",
                "task_template": "流程类型：{{workflow_type}}\n请按照方案执行开发：\n\n需求名称：{{name}}\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n方案文件：{{plan_doc}}",
                "handoff": {
                  "input_schema": "workflow.dev.input.v1",
                  "output_schema": "dev_test.dev.v1",
                  "artifact_contract_ref": "dev_test.dev.v1",
                  "success_criteria": [
                    "代码改动完成并位于指定工作分支",
                    "相关验证或测试已执行并记录",
                    "开发文档写入指定交付目录",
                    "返回 deliverable、main_branch、work_branch、verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 已确认直接继续后续流程，已委派 {{role_folder:dev}} 开始开发。"
              }
            },
            "revise": {
              "target": "plan",
              "delegate": {
                "role": "planner",
                "skill": "plan-requirement",
                "task_template": "流程类型：{{workflow_type}}\n请根据以下修改意见重新设计方案：\n\n需求描述：{{requirement_description}}\n附件文件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n\n{{revision_text}}",
                "handoff": {
                  "input_schema": "workflow.plan.input.v1",
                  "output_schema": "dev_test.plan.v1",
                  "artifact_contract_ref": "dev_test.plan.v1",
                  "success_criteria": [
                    "方案文档写入指定交付目录",
                    "返回 deliverable、main_branch、work_branch",
                    "返回 verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[方案修改] 需求「{{name}}」({{id}}) 已确认回到 Plan 修改，Plan Agent 正在重新设计方案。"
              }
            }
          },
          "allowed_channels": [
            "web",
            "feishu",
            "assistant"
          ]
        },
        "dev": {
          "type": "delegation",
          "label": "开发",
          "artifact_contract": {
            "ref": "dev_test.dev.v1"
          },
          "evaluator": {
            "ref": "dev_test.dev.v1"
          },
          "context_requirements": {
            "readiness_policy": "record_only",
            "sources": [
              {
                "id": "user_input",
                "type": "workflow_input",
                "required": true,
                "fields": [
                  "requirement_description",
                  "requirement_files",
                  "main_branch",
                  "work_branch"
                ]
              },
              {
                "id": "plan_artifact",
                "type": "artifact",
                "required": false,
                "refs": [
                  "plan_doc"
                ]
              },
              {
                "id": "service_codebase_location",
                "type": "codebase_location",
                "required": false,
                "fields": [
                  "repo_path",
                  "container_path"
                ],
                "verify_exists": true,
                "verify_mounted_for_role": true
              }
            ]
          },
          "quality_gate": {
            "pass_policy": "all_blocking_pass",
            "evaluators": [
              {
                "type": "schema",
                "blocking": true
              },
              {
                "type": "artifact",
                "blocking": true
              },
              {
                "type": "stage_rules",
                "blocking": true
              },
              {
                "type": "context_coverage",
                "blocking": true
              },
              {
                "type": "evidence",
                "blocking": true
              },
              {
                "type": "consistency",
                "blocking": true
              },
              {
                "type": "llm_judge",
                "blocking": false
              }
            ]
          },
          "delegate": {
            "role": "dev",
            "skill": "dev-requirement",
            "task_template": "流程类型：{{workflow_type}}\n请按照方案执行开发：\n\n需求名称：{{name}}\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n方案文件：{{plan_doc}}",
            "handoff": {
              "input_schema": "workflow.dev.input.v1",
              "output_schema": "dev_test.dev.v1",
              "artifact_contract_ref": "dev_test.dev.v1",
              "success_criteria": [
                "代码改动完成并位于指定工作分支",
                "相关验证或测试已执行并记录",
                "开发文档写入指定交付目录",
                "返回 deliverable、main_branch、work_branch、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "dev_examine",
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 开发已完成，已委派 {{role_folder:dev_examiner}} 进行开发复核与 Code Review。"
              }
            },
            "failure": {
              "target": "dev",
              "notify": {
                "template": "[流程异常] 需求「{{name}}」({{id}}) 开发失败，请检查。"
              }
            }
          }
        },
        "dev_examine": {
          "type": "delegation",
          "label": "开发复核",
          "evaluator": {
            "ref": "dev_test.dev_review.v1"
          },
          "delegate": {
            "role": "dev_examiner",
            "skill": "dev-examine",
            "task_template": "流程类型：{{workflow_type}}\n请对以下开发结果执行复核（重点：与方案一致性、实现质量、代码审查）：\n\n需求名称：{{name}}\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n方案文档：{{plan_doc}}\n开发文档：{{dev_doc}}",
            "handoff": {
              "input_schema": "workflow.review.input.v1",
              "output_schema": "dev_test.dev.v1",
              "artifact_contract_ref": "dev_test.dev.v1",
              "success_criteria": [
                "完成实现和文档复核",
                "返回 passed 或 needs_revision verdict",
                "findings 和 evidence 指向具体问题或通过依据"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "awaiting_confirm",
              "card": {
                "ref": "deploy_confirm"
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 开发复核通过！\n\n工作分支：{{work_branch}}\n交付文档：{{deliverable}}\n\n请点击卡片按钮确认部署。"
              }
            },
            "failure": {
              "target": "dev_examine_confirm",
              "card": {
                "ref": "dev_examine_confirm"
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 开发复核未通过 ❌\n\n{{result_summary}}\n\n请确认：直接继续后续流程，或委派 {{role_folder:dev}} 按复核意见修正。"
              }
            }
          }
        },
        "dev_examine_confirm": {
          "type": "interrupt",
          "label": "确认回修或继续后续流程",
          "card": {
            "ref": "dev_examine_confirm"
          },
          "kind": "approval",
          "title": "确认回修或继续后续流程",
          "allowed_actions": [
            "approve",
            "revise"
          ],
          "resume_payload_schema": {
            "schema": {
              "type": "object",
              "properties": {
                "revision_text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "on_resume": {
            "approve": {
              "target": "awaiting_confirm",
              "card": {
                "ref": "deploy_confirm"
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 已确认直接继续后续流程。\n\n请点击卡片按钮确认部署。"
              }
            },
            "revise": {
              "target": "dev",
              "delegate": {
                "role": "dev",
                "skill": "dev-bugfix",
                "task_template": "流程类型：{{workflow_type}}\n请根据开发复核意见修正实现：\n\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n交付文档：{{dev_doc}}\n测试文档：{{test_doc}}\n\n补充修改意见：\n{{revision_text}}",
                "handoff": {
                  "input_schema": "workflow.fix.input.v1",
                  "output_schema": "dev_test.dev.v1",
                  "artifact_contract_ref": "dev_test.dev.v1",
                  "success_criteria": [
                    "修复或回修完成并保持在指定工作分支",
                    "相关验证或回归测试已执行并记录",
                    "返回修复 verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 已确认回到开发修正，已委派 {{role_folder:dev}} 处理。"
              }
            }
          },
          "allowed_channels": [
            "web",
            "feishu",
            "assistant"
          ]
        },
        "awaiting_confirm": {
          "type": "interrupt",
          "label": "确认预发部署",
          "card": {
            "ref": "deploy_confirm"
          },
          "kind": "approval",
          "title": "确认预发部署",
          "allowed_actions": [
            "approve"
          ],
          "resume_payload_schema": {
            "schema": {
              "type": "object",
              "properties": {
                "revision_text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "on_resume": {
            "approve": {
              "target": "ops_deploy",
              "delegate": {
                "role": "ops",
                "skill": "ops-staging-deploy",
                "task_template": "流程类型：{{workflow_type}}\n请部署以下服务到预发环境：\n\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n\n注意：请基于工作分支部署到预发环境，并记录部署结果。",
                "handoff": {
                  "input_schema": "workflow.deploy.input.v1",
                  "output_schema": "dev_test.ops_deploy.v1",
                  "artifact_contract_ref": "dev_test.ops_deploy.v1",
                  "success_criteria": [
                    "基于工作分支执行预发部署",
                    "预发部署动作完成并记录结果",
                    "返回 main_branch、work_branch、verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 已确认，正在委派 {{role_folder:ops}} 部署预发环境。"
              }
            }
          },
          "allowed_channels": [
            "web",
            "feishu",
            "assistant"
          ]
        },
        "ops_deploy": {
          "type": "delegation",
          "label": "预发部署",
          "artifact_contract": {
            "ref": "dev_test.ops_deploy.v1"
          },
          "evaluator": {
            "ref": "dev_test.ops_deploy.v1"
          },
          "delegate": {
            "role": "ops",
            "skill": "ops-staging-deploy",
            "handoff": {
              "input_schema": "workflow.deploy.input.v1",
              "output_schema": "dev_test.ops_deploy.v1",
              "artifact_contract_ref": "dev_test.ops_deploy.v1",
              "success_criteria": [
                "基于工作分支执行预发部署",
                "预发部署动作完成并记录结果",
                "返回 main_branch、work_branch、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "testing_confirm",
              "card": {
                "ref": "testing_confirm"
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 预发部署成功 ✅\n\n请先确认接口测试使用的 access_token，再进入测试阶段。"
              }
            },
            "failure": {
              "target": "ops_failed",
              "notify": {
                "template": "[流程终止] 需求「{{name}}」({{id}}) 预发部署失败 ❌\n\n{{result_summary}}"
              }
            }
          }
        },
        "testing_confirm": {
          "type": "interrupt",
          "label": "确认测试 Token",
          "card": {
            "ref": "testing_confirm"
          },
          "kind": "credential",
          "title": "确认测试 Token",
          "allowed_actions": [
            "submit",
            "skip"
          ],
          "resume_payload_schema": {
            "schema": {
              "type": "object",
              "properties": {
                "access_token": {
                  "type": "string",
                  "minLength": 1
                },
                "skipped": {
                  "type": "boolean"
                }
              }
            }
          },
          "on_resume": {
            "submit": {
              "target": "testing",
              "delegate": {
                "role": "test",
                "skill": "test-requirement",
                "task_template": "流程类型：{{workflow_type}}\n请对以下需求进行测试：\n\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n交付文档：{{dev_doc}}\n测试用例文档：\n{{test_case_files}}\n说明：如提供测试用例文档，测试文档中的用例必须使用该文档内的用例；可基于需求、方案和实现额外补充必要用例。\naccess_token: {{access_token}}",
                "handoff": {
                  "input_schema": "workflow.test.input.v1",
                  "output_schema": "dev_test.testing.v1",
                  "artifact_contract_ref": "dev_test.testing.v1",
                  "success_criteria": [
                    "测试完成或明确记录阻塞原因",
                    "测试文档写入指定交付目录",
                    "返回 total、passed、failed、blocked、bugs、verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 已确认 access_token，已委派 {{role_folder:test}} 开始测试。"
              }
            },
            "skip": {
              "target": "testing",
              "delegate": {
                "role": "test",
                "skill": "test-requirement",
                "task_template": "流程类型：{{workflow_type}}\n请对以下需求进行测试：\n\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n交付文档：{{dev_doc}}\n测试用例文档：\n{{test_case_files}}\n说明：如提供测试用例文档，测试文档中的用例必须使用该文档内的用例；可基于需求、方案和实现额外补充必要用例。",
                "handoff": {
                  "input_schema": "workflow.test.input.v1",
                  "output_schema": "dev_test.testing.v1",
                  "artifact_contract_ref": "dev_test.testing.v1",
                  "success_criteria": [
                    "测试完成或明确记录阻塞原因",
                    "测试文档写入指定交付目录",
                    "返回 total、passed、failed、blocked、bugs、verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              }
            }
          },
          "allowed_channels": [
            "web",
            "feishu",
            "assistant"
          ]
        },
        "testing": {
          "type": "delegation",
          "label": "测试",
          "artifact_contract": {
            "ref": "dev_test.testing.v1"
          },
          "evaluator": {
            "ref": "dev_test.testing.v1"
          },
          "delegate": {
            "role": "test",
            "skill": "test-requirement",
            "handoff": {
              "input_schema": "workflow.test.input.v1",
              "output_schema": "dev_test.testing.v1",
              "artifact_contract_ref": "dev_test.testing.v1",
              "success_criteria": [
                "测试完成或明确记录阻塞原因",
                "测试文档写入指定交付目录",
                "返回 total、passed、failed、blocked、bugs、verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "passed",
              "notify": {
                "template": "[流程完成] 需求「{{name}}」({{id}}) 测试全部通过 ✅，可以准备上线！"
              }
            },
            "failure": {
              "target": "fixing",
              "delegate": {
                "role": "dev",
                "skill": "dev-bugfix",
                "task_template": "流程类型：{{workflow_type}}\n请修复以下测试发现的问题（Round {{round}}）：\n\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n交付文档：{{dev_doc}}\n测试用例文档：\n{{test_case_files}}\n说明：如提供测试用例文档，测试文档中的用例必须使用该文档内的用例；可基于需求、方案和实现额外补充必要用例。\n测试文档：{{test_doc}}\n\n测试报告：\n{{delegation_result}}",
                "handoff": {
                  "input_schema": "workflow.fix.input.v1",
                  "output_schema": "dev_test.dev.v1",
                  "artifact_contract_ref": "dev_test.dev.v1",
                  "success_criteria": [
                    "修复或回修完成并保持在指定工作分支",
                    "相关验证或回归测试已执行并记录",
                    "返回修复 verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) 测试发现问题 ❌\n{{result_summary}}\n进入 Round {{round}} 修复流程，已委派 {{role_folder:dev}} 修复。"
              },
              "effects": {
                "increment_round": true
              }
            }
          }
        },
        "fixing": {
          "type": "delegation",
          "label": "修复",
          "delegate": {
            "role": "dev",
            "skill": "dev-bugfix",
            "handoff": {
              "input_schema": "workflow.fix.input.v1",
              "output_schema": "dev_test.dev.v1",
              "artifact_contract_ref": "dev_test.dev.v1",
              "success_criteria": [
                "修复或回修完成并保持在指定工作分支",
                "相关验证或回归测试已执行并记录",
                "返回修复 verdict、summary、findings、evidence"
              ],
              "auto_retry": {
                "enabled": false,
                "max_attempts": 0,
                "retryable_failures": []
              }
            }
          },
          "on_complete": {
            "success": {
              "target": "ops_deploy",
              "delegate": {
                "role": "ops",
                "skill": "ops-staging-deploy",
                "task_template": "流程类型：{{workflow_type}}\n请部署以下服务到预发环境（修复后重新部署）：\n\n原始需求描述：{{requirement_description}}\n原始附件：\n{{requirement_files}}\n服务名称：{{service}}\n主分支：{{main_branch}}\n工作分支：{{work_branch}}\n\n注意：请基于最新工作分支重新部署到预发环境，并记录部署结果。",
                "handoff": {
                  "input_schema": "workflow.deploy.input.v1",
                  "output_schema": "dev_test.ops_deploy.v1",
                  "artifact_contract_ref": "dev_test.ops_deploy.v1",
                  "success_criteria": [
                    "基于工作分支执行预发部署",
                    "预发部署动作完成并记录结果",
                    "返回 main_branch、work_branch、verdict、summary、findings、evidence"
                  ],
                  "auto_retry": {
                    "enabled": false,
                    "max_attempts": 0,
                    "retryable_failures": []
                  }
                }
              },
              "notify": {
                "template": "[流程进展] 需求「{{name}}」({{id}}) Round {{round}} 修复完成，已委派 {{role_folder:ops}} 重新部署预发。"
              }
            },
            "failure": {
              "target": "fixing",
              "notify": {
                "template": "[流程异常] 需求「{{name}}」({{id}}) Round {{round}} 修复失败，请检查。"
              }
            }
          }
        },
        "passed": {
          "type": "terminal",
          "label": "已通过"
        },
        "ops_failed": {
          "type": "terminal",
          "label": "部署失败"
        },
        "cancelled": {
          "type": "terminal",
          "label": "已取消"
        },
        "paused": {
          "type": "system",
          "label": "已中断"
        }
      },
      "status_labels": {
        "plan": "📝 方案设计中",
        "plan_examine": "🧭 方案审核中",
        "plan_examine_confirm": "📋 方案复核审批",
        "dev": "🔧 开发中",
        "dev_examine": "🧾 开发复核中",
        "dev_examine_confirm": "📋 确认回修或继续后续流程",
        "awaiting_confirm": "⏳ 确认预发部署",
        "ops_deploy": "🚀 部署中",
        "testing_confirm": "🔐 确认测试 Token",
        "testing": "🧪 测试中",
        "fixing": "🔨 修复中",
        "passed": "✅ 已通过",
        "ops_failed": "❌ 部署失败",
        "cancelled": "🚫 已取消",
        "paused": "⏸ 已中断"
      },
      "metadata": {
        "tags": [
          "default",
          "delivery"
        ]
      },
      "create_form": {
        "fields": [
          {
            "key": "requirement_custom",
            "label": "需求描述",
            "type": "textarea",
            "placeholder": "请描述需求背景、目标、范围与限制条件",
            "required": true,
            "helper_text": "从 Plan 入口创建时，直接填写完整需求描述。",
            "visible_when": {
              "entry_points": [
                "plan"
              ]
            }
          },
          {
            "key": "requirement_files",
            "label": "需求附件",
            "type": "file_uploads",
            "helper_text": "支持上传多个文件，创建后会把文件地址一起带给 Plan Agent。",
            "visible_when": {
              "entry_points": [
                "plan"
              ]
            }
          },
          {
            "key": "test_case_files",
            "label": "测试用例文档",
            "type": "file_uploads",
            "helper_text": "可选。上传后会随流程保存到需求交付目录，测试阶段必须使用其中用例，可由测试 Agent 补充。"
          },
          {
            "key": "requirement_preset",
            "label": "关联需求",
            "type": "requirement_select",
            "searchable": true,
            "helper_text": "从 Dev 或 Testing 入口创建时，选择已有需求目录，用于定位交付物与历史文档。",
            "visible_when": {
              "entry_points": [
                "dev",
                "testing"
              ]
            }
          },
          {
            "key": "main_branch",
            "label": "main_branch（主分支，可选）",
            "type": "text",
            "placeholder": "例如：main"
          },
          {
            "key": "work_branch",
            "label": "work_branch（工作分支，可选）",
            "type": "text",
            "placeholder": "填写实际工作分支，如 erp_manhua 或 feature/xxx"
          }
        ]
      }
    }
  ]
}
