                "sandbox_error",
                "container_runtime_error",
                "timeout",
                "routing_error",
                "state_transition_error",
                "workflow_transition_error",
                "evaluation_failed",
                "invalid_input",
                "invalid_config",
                "permission_error",
                "db_error",
                "unknown_error",
                "requirement_unclear",
                "artifact_missing",
                "test_failed",
