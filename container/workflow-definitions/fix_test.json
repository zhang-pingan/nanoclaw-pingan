              "input_schema": "workflow.fix.input.v1",
              "output_schema": "fix_test.bug_fix.v1",
              "artifact_contract_ref": "fix_test.bug_fix.v1",
              "allowed_tools": [
                "bash",
                "git",
                "edit",
                "test_runner",
                "artifact_reader",
                "artifact_writer"
              ],
              "success_criteria": [
