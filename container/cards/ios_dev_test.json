{
  "plan_examine_confirm": {
    "pattern": "confirm_revise",
    "header": {
      "title_template": "📋 方案复核审批",
      "color": "orange"
    },
    "body_template": "**流程 ID**：{{id}}\n**服务**：{{service}}\n**交付文档**：projects/{{service}}/iteration/{{deliverable}}/plan.md\n**iOS Recon**：projects/{{service}}/iteration/{{deliverable}}/product-recon.json\n\n请选择：\n1) 直接继续后续流程（进入服务端开发）\n2) 回到 Plan 修改（可填写补充修改意见）",
    "actions": [
      {
        "id": "approve",
        "label": "✅ 进入开发",
        "type": "primary",
        "action_kind": "interrupt_resume",
        "resume_action": "approve"
      },
      {
        "id": "cancel_workflow",
        "label": "❌ 取消流程",
        "type": "danger",
        "action_kind": "workflow_control",
        "workflow_control_action": "cancel_workflow"
      }
    ],
    "form": {
      "name": "revision_form",
      "submit_action": {
        "id": "revise",
        "label": "✏️ 返回方案修改",
        "action_kind": "interrupt_resume",
        "resume_action": "revise"
      },
      "fields": [
        {
          "name": "revision_text",
          "label": "修改意见",
          "type": "textarea",
          "placeholder": "请输入补充修改意见",
          "required": true
        }
      ]
    }
  },
  "deploy_confirm": {
    "pattern": "info_actions",
    "header": {
      "title_template": "⏳ 确认预发部署",
      "color": "blue"
    },
    "body_template": "**流程 ID**：{{id}}\n**需求**：{{name}}\n**服务**：{{service}}\n**工作分支**：{{work_branch}}\n**交付目录**：{{deliverable}}\n\n请选择是否开始预发部署。部署完成后将进入 iOS 联调验收。",
    "actions": [
      {
        "id": "approve",
        "label": "✅ 开始预发部署",
        "type": "primary",
        "action_kind": "interrupt_resume",
        "resume_action": "approve"
      },
      {
        "id": "pause_workflow",
        "label": "⏸ 暂缓",
        "action_kind": "workflow_control",
        "workflow_control_action": "pause_workflow"
      },
      {
        "id": "cancel_workflow",
        "label": "❌ 取消流程",
        "type": "danger",
        "action_kind": "workflow_control",
        "workflow_control_action": "cancel_workflow"
      }
    ]
  },
  "dev_examine_confirm": {
    "pattern": "confirm_revise",
    "header": {
      "title_template": "📋 确认回修或继续后续流程",
      "color": "orange"
    },
    "body_template": "**流程 ID**：{{id}}\n**服务**：{{service}}\n**工作分支**：{{work_branch}}\n**交付目录**：{{deliverable}}\n\n请选择：\n1) 直接继续后续流程\n2) 回到服务端开发修正（可填写补充修改意见）",
    "actions": [
      {
        "id": "approve",
        "label": "✅ 继续后续流程",
        "type": "primary",
        "action_kind": "interrupt_resume",
        "resume_action": "approve"
      },
      {
        "id": "cancel_workflow",
        "label": "❌ 取消流程",
        "type": "danger",
        "action_kind": "workflow_control",
        "workflow_control_action": "cancel_workflow"
      }
    ],
    "form": {
      "name": "revision_form",
      "submit_action": {
        "id": "revise",
        "label": "✏️ 返回开发修正",
        "action_kind": "interrupt_resume",
        "resume_action": "revise"
      },
      "fields": [
        {
          "name": "revision_text",
          "label": "修改意见",
          "type": "textarea",
          "placeholder": "请输入补充修改意见",
          "required": true
        }
      ]
    }
  },
  "testing_confirm": {
    "pattern": "form_submit",
    "header": {
      "title_template": "🔐 填写 iOS 联调测试信息",
      "color": "orange"
    },
    "body_template": "**流程 ID**：{{id}}\n**需求**：{{name}}\n**服务**：{{service}}\n**交付目录**：{{deliverable}}\n\n部署已完成。可填写 iOS 联调验收所需的 access_token；如本轮验收无需鉴权，也可直接跳过当前节点。",
    "actions": [
      {
        "id": "skip",
        "label": "⏭ 跳过鉴权直接验收",
        "action_kind": "interrupt_resume",
        "resume_action": "skip"
      },
      {
        "id": "pause_workflow",
        "label": "⏸ 暂缓",
        "action_kind": "workflow_control",
        "workflow_control_action": "pause_workflow"
      },
      {
        "id": "cancel_workflow",
        "label": "❌ 取消流程",
        "type": "danger",
        "action_kind": "workflow_control",
        "workflow_control_action": "cancel_workflow"
      }
    ],
    "form": {
      "name": "access_token_form",
      "submit_action": {
        "id": "submit",
        "label": "🔐 提交 Token 并开始 iOS 验收",
        "type": "primary",
        "action_kind": "interrupt_resume",
        "resume_action": "submit"
      },
      "fields": [
        {
          "name": "access_token",
          "label": "Access Token",
          "type": "text",
          "placeholder": "请输入 iOS 联调验收所需的 access_token",
          "required": true
        }
      ]
    }
  }
}
