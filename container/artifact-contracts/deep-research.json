[
  {
    "id": "deep_research.plan.v1",
    "version": 1,
    "description": "Deep Research plan stage must write a research plan and initial traceability matrix.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/research_plan.json",
        "required": true,
        "body_required_fields": [
          "schema_version",
          "research_question",
          "subquestions",
          "source_strategy",
          "quality_criteria",
          "stop_criteria"
        ],
        "max_bytes": 200000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/traceability.json",
        "required": true,
        "body_required_fields": [
          "research_question",
          "subquestions",
          "coverage"
        ],
        "max_bytes": 200000
      }
    ]
  },
  {
    "id": "deep_research.collect.v1",
    "version": 1,
    "description": "Deep Research collect stage must write sources and search log.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/sources.json",
        "required": true,
        "max_bytes": 400000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/search_log.json",
        "required": true,
        "max_bytes": 400000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/traceability.json",
        "required": true,
        "max_bytes": 200000
      }
    ]
  },
  {
    "id": "deep_research.collect_review.v1",
    "version": 1,
    "description": "Deep Research source review must validate source coverage and route collection revisions.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "route", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "route": {
          "type": "string",
          "enum": ["analyze", "collect", "failed", "collect_review"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/source_review.json",
        "required": true,
        "body_required_fields": ["verdict", "route", "summary", "checked_at"],
        "body_payload_field_matches": [
          {
            "code": "deep_research.collect_review_verdict_mismatch",
            "severity": "high",
            "body_field": "verdict",
            "payload_field": "verdict",
            "then_status": "failed",
            "message": "source_review.json verdict does not match handoff verdict."
          },
          {
            "code": "deep_research.collect_review_route_mismatch",
            "severity": "high",
            "body_field": "route",
            "payload_field": "route",
            "then_status": "failed",
            "message": "source_review.json route does not match handoff route."
          }
        ],
        "max_bytes": 300000
      }
    ],
    "payload_rules": [
      {
        "code": "deep_research.collect_review_needs_revision",
        "severity": "medium",
        "field": "verdict",
        "eq": "needs_revision",
        "then_status": "needs_revision",
        "message": "Deep Research source reviewer requested collection revision."
      },
      {
        "code": "deep_research.collect_review_failed",
        "severity": "high",
        "field": "verdict",
        "eq": "failed",
        "then_status": "failed",
        "message": "Deep Research source reviewer failed the source set."
      },
      {
        "code": "deep_research.collect_review_pending",
        "severity": "medium",
        "field": "verdict",
        "eq": "pending",
        "then_status": "pending",
        "message": "Deep Research source reviewer marked review pending."
      }
    ]
  },
  {
    "id": "deep_research.analyze.v1",
    "version": 1,
    "description": "Deep Research analyze stage must write evidence and findings.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/evidence.json",
        "required": true,
        "max_bytes": 500000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/findings.json",
        "required": true,
        "max_bytes": 300000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/traceability.json",
        "required": true,
        "max_bytes": 250000
      }
    ]
  },
  {
    "id": "deep_research.analyze_review.v1",
    "version": 1,
    "description": "Deep Research evidence review must validate source/evidence/finding mappings and route evidence revisions.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "route", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "route": {
          "type": "string",
          "enum": ["write", "analyze", "collect", "failed", "analyze_review"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/evidence_review.json",
        "required": true,
        "body_required_fields": ["verdict", "route", "summary", "checked_at"],
        "body_payload_field_matches": [
          {
            "code": "deep_research.analyze_review_verdict_mismatch",
            "severity": "high",
            "body_field": "verdict",
            "payload_field": "verdict",
            "then_status": "failed",
            "message": "evidence_review.json verdict does not match handoff verdict."
          },
          {
            "code": "deep_research.analyze_review_route_mismatch",
            "severity": "high",
            "body_field": "route",
            "payload_field": "route",
            "then_status": "failed",
            "message": "evidence_review.json route does not match handoff route."
          }
        ],
        "max_bytes": 300000
      }
    ],
    "payload_rules": [
      {
        "code": "deep_research.analyze_review_needs_revision",
        "severity": "medium",
        "field": "verdict",
        "eq": "needs_revision",
        "then_status": "needs_revision",
        "message": "Deep Research evidence reviewer requested analysis revision."
      },
      {
        "code": "deep_research.analyze_review_failed",
        "severity": "high",
        "field": "verdict",
        "eq": "failed",
        "then_status": "failed",
        "message": "Deep Research evidence reviewer failed the evidence set."
      },
      {
        "code": "deep_research.analyze_review_pending",
        "severity": "medium",
        "field": "verdict",
        "eq": "pending",
        "then_status": "pending",
        "message": "Deep Research evidence reviewer marked review pending."
      }
    ]
  },
  {
    "id": "deep_research.write.v1",
    "version": 1,
    "description": "Deep Research writer must publish a formal structured research report.json.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/report.json",
        "required": true,
        "body_required_fields": [
          "schema_version",
          "title",
          "status",
          "language",
          "generated_at",
          "research_question",
          "methodology",
          "summary",
          "sections",
          "source_ids"
        ],
        "max_bytes": 600000
      }
    ]
  },
  {
    "id": "deep_research.review.v1",
    "version": 1,
    "description": "Deep Research reviewer must write review.json and route verdict.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "verdict", "route", "summary"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "needs_revision", "pending"]
        },
        "route": {
          "type": "string",
          "enum": ["publish", "write", "analyze", "collect", "failed", "review"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/review.json",
        "required": true,
        "body_required_fields": ["verdict", "route", "summary", "checked_at"],
        "body_payload_field_matches": [
          {
            "code": "deep_research.review_verdict_mismatch",
            "severity": "high",
            "body_field": "verdict",
            "payload_field": "verdict",
            "then_status": "failed",
            "message": "review.json verdict does not match handoff verdict."
          },
          {
            "code": "deep_research.review_route_mismatch",
            "severity": "high",
            "body_field": "route",
            "payload_field": "route",
            "then_status": "failed",
            "message": "review.json route does not match handoff route."
          }
        ],
        "max_bytes": 300000
      }
    ],
    "payload_rules": [
      {
        "code": "deep_research.review_needs_revision",
        "severity": "medium",
        "field": "verdict",
        "eq": "needs_revision",
        "then_status": "needs_revision",
        "message": "Deep Research reviewer requested a revision."
      },
      {
        "code": "deep_research.review_failed",
        "severity": "high",
        "field": "verdict",
        "eq": "failed",
        "then_status": "failed",
        "message": "Deep Research reviewer failed the report."
      },
      {
        "code": "deep_research.review_pending",
        "severity": "medium",
        "field": "verdict",
        "eq": "pending",
        "then_status": "pending",
        "message": "Deep Research reviewer marked the report pending."
      }
    ]
  }
]
