  {
    "id": "ios_dev_test.ios_recon.v1",
    "version": 1,
    "description": "iOS recon stage must publish product recon and impact analysis JSON artifacts.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": [
        "deliverable",
        "main_branch",
        "work_branch",
        "product_recon",
        "impact_analysis"
      ],
      "properties": {
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "main_branch": {
          "type": "string",
          "minLength": 1
        },
        "work_branch": {
          "type": "string",
          "minLength": 1
        },
        "product_recon": {
          "type": "string",
          "minLength": 1
        },
        "impact_analysis": {
          "type": "string",
          "minLength": 1
        },
        "prototype_analysis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/product-recon.json",
        "required": true,
        "body_required_fields": [
          "version",
          "platform",
          "service",
          "session_id",
          "flows",
          "evidence"
        ],
        "max_bytes": 300000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/impact-analysis.json",
        "required": true,
        "body_required_fields": [
          "version",
          "service",
          "platform",
          "client_impact",
          "server_impact",
          "evidence"
        ],
        "max_bytes": 200000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/prototype-analysis.json",
        "required": false,
        "body_required_fields": [
          "version",
          "service",
          "source_files",
          "screens",
          "evidence"
        ],
        "max_bytes": 200000
      }
    ]
  },
