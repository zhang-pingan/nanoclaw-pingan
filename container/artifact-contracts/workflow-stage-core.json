[
  {
    "id": "dev_test.plan.v1",
    "version": 1,
    "description": "Plan stage must publish a plan document and branch metadata.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "main_branch", "work_branch"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "main_branch": { "type": "string", "minLength": 1 },
        "work_branch": { "type": "string", "minLength": 1 },
        "traceability_path": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/plan.md",
        "required": true,
        "frontmatter_required": ["service", "deliverable", "doc_type"],
        "content_checks": [
          {
            "code": "missing_acceptance_criteria",
            "severity": "high",
            "any_of": ["验收标准", "acceptance criteria"],
            "message": "plan.md 缺少验收标准说明。"
          },
          {
            "code": "missing_scope_definition",
            "severity": "medium",
            "any_of": ["范围", "scope", "边界"],
            "message": "plan.md 缺少范围或边界定义。"
          },
          {
            "code": "missing_risk_assessment",
            "severity": "medium",
            "any_of": ["风险", "约束", "限制"],
            "message": "plan.md 缺少风险或约束说明。"
          }
        ],
        "max_bytes": 200000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/traceability.json",
        "required": true,
        "max_bytes": 200000
      }
    ]
  },
  {
    "id": "dev_test.dev.v1",
    "version": 1,
    "description": "Development stage must publish an implementation document and branch metadata.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": ["deliverable", "main_branch", "work_branch"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "main_branch": { "type": "string", "minLength": 1 },
        "work_branch": { "type": "string", "minLength": 1 },
        "traceability_path": { "type": "string", "minLength": 1 }
      }
    },
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/dev.md",
        "required": true,
        "frontmatter_required": ["service", "deliverable", "doc_type"],
        "content_checks": [
          {
            "code": "missing_plan_reference",
            "severity": "medium",
            "any_of": ["plan\\.md", "方案"],
            "message": "dev.md 未明确引用方案产物或方案约束。"
          },
          {
            "code": "missing_impact_scope",
            "severity": "medium",
            "any_of": ["影响范围", "影响面", "变更范围", "scope"],
            "message": "dev.md 缺少影响范围说明。"
          },
          {
            "code": "missing_validation_notes",
            "severity": "high",
            "any_of": ["验证", "自测", "测试"],
            "message": "dev.md 缺少验证或自测说明。"
          }
        ],
        "max_bytes": 250000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/traceability.json",
        "required": true,
        "max_bytes": 200000
      }
    ]
  },
  {
    "id": "dev_test.ops_deploy.v1",
    "version": 1,
    "description": "Deployment stage must return deployment branch metadata.",
    "payload": {
      "required": ["main_branch", "work_branch"],
      "properties": {
        "main_branch": { "type": "string", "minLength": 1 },
        "work_branch": { "type": "string", "minLength": 1 }
      }
    }
  },
  {
    "id": "dev_test.testing.v1",
    "version": 1,
    "description": "Testing stage must return a structured test result and test document reference.",
    "payload": {
      "required": [
        "deliverable",
        "test_doc",
        "total",
        "passed",
        "failed",
        "blocked"
      ],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "test_doc": { "type": "string", "minLength": 1 },
        "total": { "type": "number" },
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "blocked": { "type": "number" }
      }
    },
    "payload_rules": [
      {
        "code": "test_cases_failed",
        "severity": "high",
        "field": "failed",
        "gt": 0,
        "then_status": "failed",
        "message": "测试未通过，失败用例数 {{failed}}。"
      }
    ]
  },
  {
    "id": "fix_test.bug_fix.v1",
    "version": 1,
    "description": "Bug fix stage must return a deliverable and final work branch.",
    "payload": {
      "required": ["deliverable", "main_branch", "work_branch"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "main_branch": { "type": "string", "minLength": 1 },
        "work_branch": { "type": "string", "minLength": 1 }
      }
    }
  },
  {
    "id": "fix_test.ops_deploy.v1",
    "version": 1,
    "description": "Bug deployment stage must return deployment branch metadata.",
    "payload": {
      "required": ["main_branch", "work_branch"],
      "properties": {
        "main_branch": { "type": "string", "minLength": 1 },
        "work_branch": { "type": "string", "minLength": 1 }
      }
    }
  },
  {
    "id": "fix_test.bug_test.v1",
    "version": 1,
    "description": "Bug verification stage must return structured test counts.",
    "payload": {
      "required": [
        "deliverable",
        "test_doc",
        "total",
        "passed",
        "failed",
        "blocked"
      ],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "test_doc": { "type": "string", "minLength": 1 },
        "total": { "type": "number" },
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "blocked": { "type": "number" }
      }
    },
    "payload_rules": [
      {
        "code": "test_cases_failed",
        "severity": "high",
        "field": "failed",
        "gt": 0,
        "then_status": "failed",
        "message": "测试未通过，失败用例数 {{failed}}。"
      }
    ]
  }
]
