  {
    "id": "dev_test.testing.v1",
    "version": 1,
    "description": "Testing stage must return a structured test result and test document reference.",
    "payload": {
      "required": [
        "deliverable",
        "test_doc",
        "total",
        "passed",
        "failed",
        "blocked"
      ],
      "properties": {
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "test_doc": {
          "type": "string",
          "minLength": 1
        },
        "total": {
          "type": "number"
        },
        "passed": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        },
        "blocked": {
          "type": "number"
        }
      }
    },
    "payload_rules": [
      {
        "code": "test_cases_failed",
        "severity": "high",
        "field": "failed",
        "gt": 0,
        "then_status": "failed",
        "message": "测试未通过，失败用例数 {{failed}}。"
      }
    ]
  },
