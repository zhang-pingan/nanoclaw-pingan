  {
    "id": "ios_dev_test.ios_acceptance.v1",
    "version": 1,
    "description": "iOS acceptance stage must publish executable iOS test plan and acceptance report.",
    "allowed_artifact_roots": ["/workspace/projects"],
    "payload": {
      "required": [
        "deliverable",
        "ios_test_plan",
        "acceptance_report",
        "total",
        "passed",
        "failed",
        "blocked"
      ],
      "properties": {
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "ios_test_plan": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_report": {
          "type": "string",
          "minLength": 1
        },
        "total": {
          "type": "number"
        },
        "passed": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        },
        "blocked": {
          "type": "number"
        }
      }
    },
    "payload_rules": [
      {
        "code": "ios_acceptance_cases_failed",
        "severity": "high",
        "field": "failed",
        "gt": 0,
        "then_status": "failed",
        "message": "iOS 联调验收未通过，失败用例数 {{failed}}。"
      },
      {
        "code": "ios_acceptance_cases_blocked",
        "severity": "high",
        "field": "blocked",
        "gt": 0,
        "then_status": "failed",
        "message": "iOS 联调验收存在阻塞用例数 {{blocked}}。"
      }
    ],
    "files": [
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/ios-test-plan.json",
        "required": true,
        "body_required_fields": [
          "version",
          "platform",
          "service",
          "session_purpose",
          "cases",
          "evidence"
        ],
        "max_bytes": 250000
      },
      {
        "path": "projects/{{service}}/iteration/{{deliverable}}/acceptance-report.json",
        "required": true,
        "body_required_fields": [
          "version",
          "platform",
          "service",
          "session_id",
          "summary.total",
          "summary.passed",
          "summary.failed",
          "summary.blocked",
          "cases",
          "verdict",
          "evidence"
        ],
        "body_payload_field_matches": [
          {
            "code": "ios_acceptance_report_total_mismatch",
            "severity": "high",
            "body_field": "summary.total",
            "payload_field": "total",
            "then_status": "failed",
            "message": "acceptance-report.json summary.total ({{body_value}}) does not match payload.total ({{payload_value}})."
          },
          {
            "code": "ios_acceptance_report_passed_mismatch",
            "severity": "high",
            "body_field": "summary.passed",
            "payload_field": "passed",
            "then_status": "failed",
            "message": "acceptance-report.json summary.passed ({{body_value}}) does not match payload.passed ({{payload_value}})."
          },
          {
            "code": "ios_acceptance_report_failed_mismatch",
            "severity": "high",
            "body_field": "summary.failed",
            "payload_field": "failed",
            "then_status": "failed",
            "message": "acceptance-report.json summary.failed ({{body_value}}) does not match payload.failed ({{payload_value}})."
          },
          {
            "code": "ios_acceptance_report_blocked_mismatch",
            "severity": "high",
            "body_field": "summary.blocked",
            "payload_field": "blocked",
            "then_status": "failed",
            "message": "acceptance-report.json summary.blocked ({{body_value}}) does not match payload.blocked ({{payload_value}})."
          }
        ],
        "body_checks": [
          {
            "type": "ios_acceptance_report",
            "code_prefix": "ios_acceptance_report",
            "severity": "high",
            "then_status": "failed"
          }
        ],
        "max_bytes": 300000
      }
    ]
  },
