{
  "provider": "tencent-docs-openapi",
  "base_url": "https://docs.qq.com",
  "auth": {
    "client_id": "",
    "client_secret": "",
    "open_id": "",
    "access_token": "",
    "refresh_token": "",
    "expires_at": 0,
    "redirect_uri": "",
    "token_file": "/home/node/.claude/skills/wecom-docs/references/token.json",
    "oauth": {
      "authorize_url": "https://docs.qq.com/oauth/v2/authorize",
      "token_url": "https://docs.qq.com/oauth/v2/token",
      "scope": "all",
      "token_request_style": "form"
    }
  },
  "headers": {},
  "endpoints": {
    "search": {
      "method": "POST",
      "path": "/openapi/drive/v2/search"
    },
    "filter": {
      "method": "POST",
      "path": "/openapi/drive/v2/files/filter"
    },
    "metadata": {
      "method": "GET",
      "path": "/openapi/drive/v2/files/{file_id}/metadata"
    },
    "collaborators": {
      "method": "GET",
      "path": "/openapi/drive/v2/files/{file_id}/collaborators"
    },
    "unread_count": {
      "method": "GET",
      "path": "/openapi/drive/v2/notification/unread-count"
    },
    "saas_list": {
      "method": "POST",
      "path": "/openapi/drive/v3/files/list"
    }
  },
  "defaults": {
    "page_size": 20,
    "keywords": [
      "需求",
      "PRD",
      "评审",
      "排期",
      "验收",
      "接口",
      "方案",
      "待确认"
    ],
    "saas_list_types": [
      "RECENT",
      "COLLABORATION_LIST",
      "SHARED"
    ]
  }
}
